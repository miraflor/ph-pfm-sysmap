digraph D_treasury_debt {
graph [rankdir=LR newrank=true compound=true nodesep=0.25 ranksep=0.7 fontname="Helvetica" splines=spline label="Level 1. Cash management, securities and debt (7 flows)" labelloc=t fontsize=12]
node [margin="0.08,0.04"]
edge [fontname="Helvetica"]
"EXT-DEALER" [shape=box style="filled,rounded" fillcolor="#ffffff" color="#333333" penwidth=1.6 fontname="Helvetica-Bold" fontsize=10 label="Dealers and\nlenders" tooltip="Dealers in government securities and other lenders"]
subgraph "cluster_INST-BSP" {
label="BSP" style="rounded,filled" fillcolor="#fbe0c4" color="#999999" fontname="Helvetica-Bold" fontsize=10 tooltip="Bangko Sentral ng Pilipinas"
"SYS-PHILPASS" [shape=box style="filled,rounded" fillcolor="#fbe0c4" color="#333333" penwidth=1 fontname="Helvetica" fontsize=10 label="PhilPaSSplus" tooltip="PhilPaSSplus, the peso real-time gross settlement system of the BSP"]
}
subgraph "cluster_INST-BTR" {
label="BTr" style="rounded,filled" fillcolor="#fbe0c4" color="#999999" fontname="Helvetica-Bold" fontsize=10 tooltip="Bureau of the Treasury"
"ACC-TSA" [shape=cylinder style="filled" fillcolor="#fbe0c4" color="#333333" penwidth=1 fontname="Helvetica" fontsize=10 label="Treasury Single\nAccount" tooltip="Treasury Single Account: accounts of BTr at the BSP"]
"SYS-BTR-DEBT" [shape=box style="filled,rounded,dotted" fillcolor="#fbe0c4" color="#333333" penwidth=1 fontname="Helvetica" fontsize=10 label="BTr debt recording\nsystem" tooltip="Debt recording system of BTr (name not stated)"]
"SYS-NROSS" [shape=box style="filled,rounded" fillcolor="#fbe0c4" color="#333333" penwidth=1 fontname="Helvetica" fontsize=10 label="NRoSS" tooltip="NRoSS, National Registry of Scripless Securities"]
}
subgraph "cluster_INST-DBM" {
label="DBM" style="rounded,filled" fillcolor="#dde9f7" color="#999999" fontname="Helvetica-Bold" fontsize=10 tooltip="Department of Budget and Management"
"SYS-BTMS" [shape=box style="filled,rounded" fillcolor="#dde9f7" color="#333333" penwidth=1 fontname="Helvetica" fontsize=10 label="BTMS" tooltip="BTMS, Budget and Treasury Management System"]
"SYS-EBUDGET-DBM" [shape=box style="filled,rounded" fillcolor="#dde9f7" color="#333333" penwidth=1 fontname="Helvetica" fontsize=10 label="e-Budget (DBM)" tooltip="e-Budget (DBM)"]
"SYS-URS" [shape=box style="filled,rounded" fillcolor="#dde9f7" color="#333333" penwidth=1 fontname="Helvetica" fontsize=10 label="URS" tooltip="URS, Unified Reporting System"]
}
"EXT-DEALER" -> "SYS-NROSS" [color="#555555" style="dashed" penwidth=1 arrowhead=normal arrowsize=0.6 tooltip="F056: Bids" label="F056" fontsize=7 fontcolor="#666666"]
"SYS-NROSS" -> "SYS-PHILPASS" [color="#555555" style="bold" penwidth=1.8 arrowhead=normal arrowsize=0.6 tooltip="F057: Settlement instruction" label="F057" fontsize=7 fontcolor="#666666"]
"EXT-DEALER" -> "ACC-TSA" [color="#a35200" style="solid" penwidth=1.3 arrowhead=normal arrowsize=0.6 tooltip="F058: Proceeds of securities and loans" label="F058" fontsize=7 fontcolor="#666666"]
"SYS-NROSS" -> "SYS-BTR-DEBT" [color="#555555bb" style="solid" penwidth=1 arrowhead=normal arrowsize=0.6 tooltip="F059: New debt" label="F059" fontsize=7 fontcolor="#666666"]
"ACC-TSA" -> "EXT-DEALER" [color="#a35200" style="solid" penwidth=1.3 arrowhead=normal arrowsize=0.6 tooltip="F060: Interest and principal" label="F060" fontsize=7 fontcolor="#666666"]
"SYS-EBUDGET-DBM" -> "SYS-BTMS" [color="#55555566" style="bold" penwidth=1.8 arrowhead=empty arrowsize=0.6 tooltip="F101: Budget data for cash flow forecasting" label="F101" fontsize=7 fontcolor="#666666"]
"SYS-URS" -> "SYS-BTMS" [color="#55555566" style="bold" penwidth=1.8 arrowhead=empty arrowsize=0.6 tooltip="F102: Execution plans and disbursement programs for cash flow forecasting" label="F102" fontsize=7 fontcolor="#666666"]
}