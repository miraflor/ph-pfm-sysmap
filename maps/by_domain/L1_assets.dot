edge [fontname="Helvetica"]
subgraph "cluster_INST-BTR" {
label="BTr" style="rounded,filled" fillcolor="#fbe0c4" color="#999999" fontname="Helvetica-Bold" fontsize=10 tooltip="Bureau of the Treasury"
"SYS-NARS" [shape=box style="filled,rounded" fillcolor="#fbe0c4" color="#333333" penwidth=1 fontname="Helvetica" fontsize=10 label="NARS" tooltip="NARS, National Asset Registry System"]
}
"INST-NGA" [shape=box style="filled,rounded" fillcolor="#eef6e6" color="#333333" penwidth=1.6 fontname="Helvetica-Bold" fontsize=10 label="National agency" tooltip="A department or agency of the national government"]
"INST-NGA" -> "SYS-NARS" [color="#555555" style="solid" penwidth=1 arrowhead=normal arrowsize=0.6 tooltip="F024: Data on important assets" label="F024" fontsize=7 fontcolor="#666666"]
}