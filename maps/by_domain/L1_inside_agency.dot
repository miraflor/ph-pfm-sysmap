digraph D_inside_agency {
graph [rankdir=LR newrank=true compound=true nodesep=0.25 ranksep=0.7 fontname="Helvetica" splines=spline label="Level 1. Between units of one agency (4 flows)" labelloc=t fontsize=12]
node [margin="0.08,0.04"]
edge [fontname="Helvetica"]
subgraph "cluster_INST-NGA" {
label="National agency" style="rounded,filled" fillcolor="#eef6e6" color="#999999" fontname="Helvetica-Bold" fontsize=10 tooltip="A department or agency of the national government"
"UNIT-NGA-ACC" [shape=box style="filled" fillcolor="#ffffff" color="#333333" penwidth=1 fontname="Helvetica" fontsize=10 label="Accounting unit" tooltip="Accounting unit of the agency, headed by the chief accountant"]
"UNIT-NGA-BUD" [shape=box style="filled" fillcolor="#ffffff" color="#333333" penwidth=1 fontname="Helvetica" fontsize=10 label="Budget unit" tooltip="Budget unit of the agency"]
"UNIT-NGA-CASH" [shape=box style="filled" fillcolor="#ffffff" color="#333333" penwidth=1 fontname="Helvetica" fontsize=10 label="Cash unit" tooltip="Cash unit of the agency, with the cashier and disbursing officers"]
"UNIT-NGA-PROP" [shape=box style="filled" fillcolor="#ffffff" color="#333333" penwidth=1 fontname="Helvetica" fontsize=10 label="Property and\ninspection" tooltip="Property unit and inspection officer or committee"]
}
"UNIT-NGA-BUD" -> "UNIT-NGA-ACC" [color="#2e6b2e" style="dotted" penwidth=1 arrowhead=normal arrowsize=0.6 tooltip="F066: The obligation request with the claim documents, and a copy of each allotment release document" label="F066" fontsize=7 fontcolor="#666666"]
"UNIT-NGA-PROP" -> "UNIT-NGA-ACC" [color="#2e6b2e" style="dotted" penwidth=1 arrowhead=normal arrowsize=0.6 tooltip="F067: Copy of the inspection and acceptance report, with the purchase order and the delivery receipt" label="F067" fontsize=7 fontcolor="#666666"]
"UNIT-NGA-CASH" -> "UNIT-NGA-ACC" [color="#2e6b2e" style="dotted" penwidth=1 arrowhead=normal arrowsize=0.6 tooltip="F068: Daily reports of checks issued and of payment orders issued, with the paid vouchers and the validated payment orders" label="F068" fontsize=7 fontcolor="#666666"]
"UNIT-NGA-ACC" -> "UNIT-NGA-BUD" [color="#2e6b2e" style="dotted" penwidth=1 arrowhead=normal arrowsize=0.6 tooltip="F069: Copy of the daily reports, of the Tax Remittance Advice and of journal entry vouchers, for posting the payable and the payment" label="F069" fontsize=7 fontcolor="#666666"]
}