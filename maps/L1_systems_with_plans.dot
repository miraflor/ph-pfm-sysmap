"UNIT-NGA-PERS" -> "SYS-GMIS" [color="#555555" style="dashed" penwidth=1 arrowhead=normal arrowsize=0.6 tooltip="F004: Monthly update of positions" label="F004" fontsize=7 fontcolor="#666666"]
"SYS-OSBPS" -> "SYS-BPMS" [color="#555555bb" style="solid" penwidth=1 arrowhead=normal arrowsize=0.6 tooltip="F005A: Proposals that enter the proposed budget" label="F005A" fontsize=7 fontcolor="#666666"]
"SYS-GMIS" -> "SYS-BPMS" [color="#555555bb" style="solid" penwidth=1 arrowhead=normal arrowsize=0.6 tooltip="F005B: Filled positions, as the basis of the personnel budget" label="F005B" fontsize=7 fontcolor="#666666"]
