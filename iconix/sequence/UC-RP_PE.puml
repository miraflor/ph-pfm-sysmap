skinparam sequenceMessageAlign left
autonumber
actor "Agency as a whole (central of…" as ROLE_AGENCY
boundary "National agency" as B_INST_NGA
control "check (not stated)" as C_not_stated_ROLE_AGENCY
participant "URS" as N_SYS_URS
entity "Agency own systems" as E_SYS_AGENCY_OWN
actor "DBM (bureaus and approving of…" as ROLE_DBM
