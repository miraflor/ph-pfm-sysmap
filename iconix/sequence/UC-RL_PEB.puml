entity "Document verification (blockc…" as E_SYS_DOCVERIFY
== RL-01 Submit the budget execution documents in URS ==
ROLE_AGENCY -> B_INST_NGA : System or office where the act takes place
B_INST_NGA -> C_not_stated_ROLE_AGENCY : Submit the budget execution documents in URS
C_not_stated_ROLE_AGENCY -> N_SYS_URS : F012 Budget execution documents entered in URS
C_not_stated_ROLE_AGENCY -> E_S_NBC : read: Release guidelines of the year issued (National Budget Circ…
== RL-02 Pass the documents to DBM ==
ROLE_DBM -> B_SYS_URS : System or office where the act takes place
B_SYS_URS -> C_not_stated_ROLE_DBM : Pass the documents to DBM
C_not_stated_ROLE_DBM -> N_INST_DBM : F021A Budget execution documents at DBM for evaluation
== RL-03A Release by the GAA as allotment order ==
ROLE_DBM -> B_INST_DBM : System or office where the act takes place
B_INST_DBM -> C_not_stated_ROLE_DBM : Release by the GAA as allotment order
note right of C_not_stated_ROLE_DBM : R-APPROP-LIMIT: No allotment above the appropriation of the item
C_not_stated_ROLE_DBM -> E_SYS_EBUDGET_DBM : use: Appropriation available (a line of the GAA)
C_not_stated_ROLE_DBM -> E_SYS_AGENCY_OWN : write: Allotment available, not yet obligated
== RL-03B Submit a Special Budget Request ==
ROLE_AGENCY -> B_INST_NGA : System or office where the act takes place
B_INST_NGA -> C_not_stated_ROLE_AGENCY : Submit a Special Budget Request
C_not_stated_ROLE_AGENCY -> E_INST_DBM : write: Special Budget Request submitted for an item that needs cle…
== RL-04A Obtain the approval of the Office of the President ==
ROLE_OP -> B_UNIT_OP : System or office where the act takes place
B_UNIT_OP -> C_not_stated_ROLE_OP : Obtain the approval of the Office of the President
C_not_stated_ROLE_OP -> E_INST_DBM : use: Special Budget Request submitted for an item that needs cle…
C_not_stated_ROLE_OP -> E_S_SBR_CLEARED : write: Request ready for evaluation (approved by the Office of the…
== RL-04B No approval of the President needed ==
ROLE_DBM -> B_INST_DBM : System or office where the act takes place
B_INST_DBM -> C_not_stated_ROLE_DBM : No approval of the President needed
C_not_stated_ROLE_DBM -> E_INST_DBM : use: Special Budget Request submitted for an item that needs cle…
C_not_stated_ROLE_DBM -> E_S_SBR_CLEARED : write: Request ready for evaluation (approved by the Office of the…
== RL-05 Evaluate and approve the SARO or GARO ==
ROLE_DBM -> B_INST_DBM : System or office where the act takes place
B_INST_DBM -> C_not_stated_ROLE_DBM : Evaluate and approve the SARO or GARO
note right of C_not_stated_ROLE_DBM : R-APPROP-LIMIT: No allotment above the appropriation of the item
C_not_stated_ROLE_DBM -> E_S_SBR_CLEARED : use: Request ready for evaluation (approved by the Office of the…
C_not_stated_ROLE_DBM -> E_SYS_EBUDGET_DBM : use: Appropriation available (a line of the GAA)
C_not_stated_ROLE_DBM -> N_SYS_ADRS : F007 Approved release document passed to ADRS
== RL-06 Release the document in ADRS ==
ROLE_DBM -> B_SYS_ADRS : System or office where the act takes place
B_SYS_ADRS -> C_not_stated_ROLE_DBM : Release the document in ADRS
C_not_stated_ROLE_DBM -> N_INST_NGA : F008 SARO or GARO available for download by the agency
C_not_stated_ROLE_DBM -> N_SYS_DOCVERIFY : F009 Record of the issued document sent to the verification reco…
== RL-07 Download and record the allotment ==
ROLE_BUDGET -> B_UNIT_NGA_BUD : System or office where the act takes place
B_UNIT_NGA_BUD -> C_not_stated_ROLE_BUDGET : Download and record the allotment
C_not_stated_ROLE_BUDGET -> E_SYS_AGENCY_OWN : write: Allotment available, not yet obligated
== RL-08 Store the fingerprint of the document ==
ROLE_DBM -> B_SYS_DOCVERIFY : System or office where the act takes place
B_SYS_DOCVERIFY -> C_not_stated_ROLE_DBM : Store the fingerprint of the document
C_not_stated_ROLE_DBM -> E_SYS_DOCVERIFY : write: Fingerprint of the document stored; any copy can be checked
@enduml
