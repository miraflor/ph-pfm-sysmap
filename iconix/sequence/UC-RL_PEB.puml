boundary "National agency" as B_INST_NGA
control "check (not stated)" as C_not_stated_ROLE_AGENCY
participant "URS" as N_SYS_URS
entity "record" as E_S_NBC
actor "DBM (bureaus and approving of…" as ROLE_DBM
boundary "URS" as B_SYS_URS
control "check (not stated)" as C_not_stated_ROLE_DBM
participant "DBM" as N_INST_DBM
boundary "DBM" as B_INST_DBM
entity "e-Budget (DBM)" as E_SYS_EBUDGET_DBM
entity "Agency own systems" as E_SYS_AGENCY_OWN
entity "DBM" as E_INST_DBM
