"S-ACCEPTED" -> "SP-09"
"SP-09" -> "S-CLAIM-OK"
"S-CLAIM-OK" -> "SP-10"
"S-NCA-AGENCY" -> "SP-10" [label="amount" fontsize=7]
"SP-10" -> "S-CLAIM-APPROVED"
"S-CLAIM-APPROVED" -> "SP-12C"
"SP-12C" -> "C-F027"
"SP-12C" -> "S-JEV-PAID"
"SP-12C" -> "S-ORS-PAID"
"C-F027" -> "SP-13C"
