digraph net {
graph [rankdir=TB nodesep=0.3 ranksep=0.35 fontname="Helvetica" label="CH-SPEND-B: Spending: from an allotment to a settled payment and its records (cohort B)" labelloc=t fontsize=12]
node [fontname="Helvetica" fontsize=9]
edge [arrowsize=0.6]
"S-MDP" [shape=ellipse style="filled" peripheries=1 fillcolor="#fde0c2" color="#a35200" label="Monthly disbursement\nprogram of the agency\n(BED 3) ●" tooltip="S-MDP"]
"C-F011" [shape=ellipse style="filled,dashed" peripheries=1 fillcolor="#fde0c2" color="#a35200" label="F011: NCA on its way to\nthe bank" tooltip="C-F011"]
"C-F008-NCA" [shape=ellipse style="filled,dashed" peripheries=1 fillcolor="#fde0c2" color="#a35200" label="F008: Advice of NCA\nissued, for download in\nADRS" tooltip="C-F008-NCA"]
"S-TSA" [shape=ellipse style="filled" peripheries=2 fillcolor="#fde0c2" color="#a35200" label="Cash in the Treasury\nSingle Account ●" tooltip="S-TSA"]
"S-NCA-BANK" [shape=ellipse style="filled" peripheries=2 fillcolor="#fde0c2" color="#a35200" label="NCA balance in the MDS\nsub-account at the\nservicing bank (a limit,\nnot cash)" tooltip="S-NCA-BANK"]
"S-NCA-AGENCY" [shape=ellipse style="filled" peripheries=2 fillcolor="#fde0c2" color="#a35200" label="NCA balance as recorded\nby the agency (registry\nof the accounting unit)" tooltip="S-NCA-AGENCY"]
"S-ALLOT" [shape=ellipse style="filled" peripheries=2 fillcolor="#d6e4f7" color="#1f4e8c" label="Allotment available, not\nyet obligated ●" tooltip="S-ALLOT"]
"S-AWARD" [shape=ellipse style="filled" peripheries=1 fillcolor="#d5ecd5" color="#2e6b2e" label="Award made" tooltip="S-AWARD"]
"S-OBLIGATED" [shape=ellipse style="filled" peripheries=1 fillcolor="#d6e4f7" color="#1f4e8c" label="Obligation recorded: ORS\nwith Box A and Box B,\nentered in the registry" tooltip="S-OBLIGATED"]
"S-CONTRACT" [shape=ellipse style="filled" peripheries=1 fillcolor="#d5ecd5" color="#2e6b2e" label="Contract or purchase\norder in force" tooltip="S-CONTRACT"]
"S-DELIVERED" [shape=ellipse style="filled" peripheries=1 fillcolor="#d5ecd5" color="#2e6b2e" label="Delivery made, with\ndelivery receipt and\ninvoice" tooltip="S-DELIVERED"]
"S-ACCEPTED" [shape=ellipse style="filled" peripheries=1 fillcolor="#d5ecd5" color="#2e6b2e" label="Delivery inspected and\naccepted: the obligation\nis due and demandable" tooltip="S-ACCEPTED"]
"S-CLAIM-OK" [shape=ellipse style="filled" peripheries=1 fillcolor="#d6e4f7" color="#1f4e8c" label="Claim examined: voucher\nwith Box A and the\naccounting entry" tooltip="S-CLAIM-OK"]
"S-CLAIM-APPROVED" [shape=ellipse style="filled" peripheries=1 fillcolor="#d6e4f7" color="#1f4e8c" label="Claim approved for\npayment: Box C certified\nand Box D approved" tooltip="S-CLAIM-APPROVED"]
"C-F027" [shape=ellipse style="filled,dashed" peripheries=1 fillcolor="#fde0c2" color="#a35200" label="F027: Instruction for an\nelectronic payment from\nBTMS, through the bank" tooltip="C-F027"]
"S-JEV-PAID" [shape=ellipse style="filled" peripheries=1 fillcolor="#e6e6e6" color="#555555" label="Payment recorded in the\nbooks (JEV: Accounts\nPayable, Cash-MDS, Due\nto BIR)" tooltip="S-JEV-PAID"]
"S-ORS-PAID" [shape=ellipse style="filled" peripheries=1 fillcolor="#e6e6e6" color="#555555" label="Payment posted in part C\nof the ORS and in the\nregistry of\ndisbursements" tooltip="S-ORS-PAID"]
"C-F127" [shape=ellipse style="filled,dashed" peripheries=1 fillcolor="#fde0c2" color="#a35200" label="F127: Payee credited\nthrough PESONet or\nInstaPay" tooltip="C-F127"]
"S-BANK-CLAIM" [shape=ellipse style="filled" peripheries=1 fillcolor="#fde0c2" color="#a35200" label="Payments made by the\nbank, to be replenished" tooltip="S-BANK-CLAIM"]
"C-F061" [shape=ellipse style="filled,dashed" peripheries=1 fillcolor="#fde0c2" color="#a35200" label="F061: Report of payments\nmade, at eTRAMS of BTr" tooltip="C-F061"]
"C-F028" [shape=ellipse style="filled,dashed" peripheries=1 fillcolor="#fde0c2" color="#a35200" label="F028: Electronic bank\nstatement, at BTMS" tooltip="C-F028"]
"C-F020" [shape=ellipse style="filled,dashed" peripheries=1 fillcolor="#fde0c2" color="#a35200" label="F020: Replenishment on\nits way from the TSA to\nthe bank" tooltip="C-F020"]
"S-SETTLED" [shape=ellipse style="filled" peripheries=1 fillcolor="#fde0c2" color="#a35200" label="Bank replenished for the\npayments it made" tooltip="S-SETTLED"]
"S-RECONCILED" [shape=ellipse style="filled" peripheries=1 fillcolor="#e6e6e6" color="#555555" label="Books, registries and\nbank agree for the\nperiod" tooltip="S-RECONCILED"]
"SP-01" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="SP-01\nIssue the NCA" tooltip="DBM (bureaus and approving officials)"]
"SP-02" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="SP-02\nCredit the NCA to the\nMDS sub-account" tooltip="Servicing bank"]
"SP-03" [shape=box style="filled" fillcolor="#eaeaea" penwidth=1.6 label="SP-03\nRecord the NCA received" tooltip="Chief accountant (head of the accounting unit)"]
"SP-05" [shape=box style="filled" fillcolor="#eaeaea" penwidth=1.6 label="SP-05\nObligate and sign the\ncontract" tooltip="Head of the budget unit"]
"SP-06" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="SP-06\nDeliver" tooltip="Supplier or contractor"]
"SP-07" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="SP-07\nInspect and accept" tooltip="Inspection officer and property custodian"]
"SP-09" [shape=box style="filled" fillcolor="#eaeaea" penwidth=1.6 label="SP-09\nPrepare and examine the\nclaim" tooltip="Chief accountant (head of the accounting unit)"]
"SP-10" [shape=box style="filled" fillcolor="#eaeaea" penwidth=1.6 label="SP-10\nCertify cash available\nand approve" tooltip="Chief accountant (head of the accounting unit)"]
"SP-12C" [shape=box style="filled" fillcolor="#eaeaea" penwidth=1.6 label="SP-12C\nPay through BTMS" tooltip="Cashier or disbursing officer"]
"SP-13C" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="SP-13C\nDebit the sub-account\nand pass the transfer to\nthe clearing house" tooltip="Servicing bank"]
"SP-14" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="SP-14\nReplenish the servicing\nbank" tooltip="Bureau of the Treasury"]
"SP-15" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="SP-15\nReceive the\nreplenishment" tooltip="Servicing bank"]
"SP-21B" [shape=box style="filled" fillcolor="#eaeaea" penwidth=1.6 label="SP-21B\nReconcile each day from\nelectronic statements" tooltip="Chief accountant (head of the accounting unit)"]
"S-MDP" -> "SP-01"
"SP-01" -> "C-F011"
"SP-01" -> "C-F008-NCA"
"SP-01" -> "S-MDP"
