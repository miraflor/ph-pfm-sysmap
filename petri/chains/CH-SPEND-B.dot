"SP-13C" -> "C-F127"
"SP-13C" -> "S-BANK-CLAIM"
"SP-13C" -> "C-F061"
"SP-13C" -> "C-F028"
"S-BANK-CLAIM" -> "SP-14"
"C-F061" -> "SP-14"
"S-TSA" -> "SP-14" [label="amount" fontsize=7]
"SP-14" -> "C-F020"
"C-F020" -> "SP-15"
"SP-15" -> "S-SETTLED"
"C-F028" -> "SP-21B"
"SP-21B" -> "S-RECONCILED"
"S-JEV-PAID" -> "SP-21B" [style=dotted arrowhead=none color="#777777" label="read" fontsize=7]
"S-NCA-AGENCY" -> "SP-21B" [style=dotted arrowhead=none color="#777777" label="read" fontsize=7]
