"PR-03" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="PR-03\nShow the opportunity and\npublish open data" tooltip="Procurement Service of DBM"]
"PR-04" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="PR-04\nSubmit and open the bids" tooltip="Supplier or contractor"]
"PR-05" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="PR-05\nEvaluate, recommend and\naward" tooltip="Head of agency or authorized official"]
"PR-06" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="PR-06\nPass procurement data to\nBTMS (planned)" tooltip="Procurement Service of DBM"]
"CO-01" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="CO-01\nPay the fee" tooltip="Collecting officer"]
"CO-02" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="CO-02\nIssue the official\nreceipt" tooltip="Collecting officer"]
"CO-03" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="CO-03\nDeposit the collections\nin full" tooltip="Collecting officer"]
"CO-04" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="CO-04\nReport collections and\ndeposits for the day" tooltip="Collecting officer"]
"CO-05" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="CO-05\nCredit the account and\nreport" tooltip="Authorized government depository bank"]
"CO-06" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="CO-06\nRecord the collections" tooltip="Chief accountant (head of the accounting unit)"]
"CO-07" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="CO-07\nTransfer the balances to\nthe TSA" tooltip="Authorized government depository bank"]
"CO-08" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="CO-08\nConsolidate the\ncollection reports" tooltip="Bureau of the Treasury"]
"CO-09" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="CO-09\nIssue the certificate of\ndeposited collections" tooltip="Bureau of the Treasury"]
"TX-01" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="TX-01\nFile the return" tooltip="Taxpayer or importer"]
"TX-02" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="TX-02\nPay the tax" tooltip="Taxpayer or importer"]
"TX-03" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="TX-03\nPass the return to the\ninternal system" tooltip="BIR office or approving official"]
"TX-04" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="TX-04\nConfirm and report the\npayment" tooltip="Authorized agent bank or payment gateway"]
"TX-05" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="TX-05\nPost the payment to the\ntaxpayer account" tooltip="BIR office or approving official"]
"TX-06" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="TX-06\nRemit the collections to\nthe TSA" tooltip="Authorized agent bank or payment gateway"]
"TX-07" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="TX-07\nCredit the TSA" tooltip="BSP"]
"TX-11" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="TX-11\nDeclare the goods" tooltip="Taxpayer or importer"]
"TX-12" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="TX-12\nAssess duties and taxes" tooltip="BOC"]
"TX-13" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="TX-13\nPay the assessed amount" tooltip="Taxpayer or importer"]
"TX-14" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="TX-14\nSend the abstract of\ncollection through PAS" tooltip="Authorized agent bank or payment gateway"]
"TX-15" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="TX-15\nConfirm the payment and\nrelease the goods" tooltip="BOC"]
"DB-01" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="DB-01\nBid in the auction" tooltip="Dealer or lender"]
"DB-02" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="DB-02\nAward and send the\nsettlement instruction" tooltip="Bureau of the Treasury"]
"DB-03" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="DB-03\nSettle securities\nagainst payment" tooltip="BSP"]
"DB-04" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="DB-04\nCredit the proceeds to\nthe TSA" tooltip="BSP"]
"DB-05" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="DB-05\nRecord the new debt" tooltip="Bureau of the Treasury"]
"DB-06" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="DB-06\nPay interest and\nprincipal" tooltip="Bureau of the Treasury"]
"RP-03" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="RP-03\nProduce the reports from\nBTMS records" tooltip="DBM (bureaus and approving officials)"]
"RP-04" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="RP-04\nSubmit the financial\nstatements" tooltip="Chief accountant (head of the accounting unit)"]
"RP-05" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="RP-05\nPrepare the Annual\nFinancial Report" tooltip="COA"]
"RP-06" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="RP-06\nSubmit information to\nCOMPASS" tooltip="Agency as a whole (central office)"]
"RP-07" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="RP-07\nPass BTMS data to\nCOMPASS (described)" tooltip="DBM (bureaus and approving officials)"]
"RP-08" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="RP-08\nPublish budget and\nspending figures" tooltip="DBM (bureaus and approving officials)"]
"PL-01" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="PL-01\nEncode and endorse\nprograms and projects in\nPIPOL" tooltip="Planning and budget officer of the agency"]
"PL-02" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="PL-02\nValidate the entries\nagainst the PIP criteria" tooltip="DEPDev PIP and TRIP secretariats"]
"PL-03" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="PL-03\nEnter the budget\nproposal in OSBPS" tooltip="Planning and budget officer of the agency"]
"PL-04" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="PL-04\nUpdate the positions in\nGMIS" tooltip="Personnel officer"]
"PL-05" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="PL-05\nBuild the proposed\nbudget" tooltip="DBM (bureaus and approving officials)"]
"PL-06" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="PL-06\nEnact the budget" tooltip="Congress"]
"PL-07" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="PL-07\nLoad the enacted budget\nin the e-Budget of DBM" tooltip="DBM (bureaus and approving officials)"]
"PL-08" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="PL-08\nMake the appropriation\navailable for release" tooltip="DBM (bureaus and approving officials)"]
