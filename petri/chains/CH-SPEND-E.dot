"C-F019" [shape=ellipse style="filled,dashed" peripheries=1 fillcolor="#fde0c2" color="#a35200" label="F019: Copy of the\nsummary list and payment\norder at BTr, on the\nsame day" tooltip="C-F019"]
"C-F033" [shape=ellipse style="filled,dashed" peripheries=1 fillcolor="#fde0c2" color="#a35200" label="F033: Validated copy of\nthe payment order, back\nat the cash unit" tooltip="C-F033"]
"C-F061" [shape=ellipse style="filled,dashed" peripheries=1 fillcolor="#fde0c2" color="#a35200" label="F061: Report of payments\nmade, at eTRAMS of BTr" tooltip="C-F061"]
"C-F020" [shape=ellipse style="filled,dashed" peripheries=1 fillcolor="#fde0c2" color="#a35200" label="F020: Replenishment on\nits way from the TSA to\nthe bank" tooltip="C-F020"]
"S-SETTLED" [shape=ellipse style="filled" peripheries=1 fillcolor="#fde0c2" color="#a35200" label="Bank replenished for the\npayments it made" tooltip="S-SETTLED"]
"C-F068" [shape=ellipse style="filled,dashed" peripheries=1 fillcolor="#e6e6e6" color="#555555" label="F068: Daily report of\npayment orders issued,\nwith the vouchers and\nvalidated orders, at\naccounting" tooltip="C-F068"]
"C-F040" [shape=ellipse style="filled,dashed" peripheries=1 fillcolor="#e6e6e6" color="#555555" label="F040: Daily report of\npayment orders, on the\nwebsite of the agency" tooltip="C-F040"]
"S-JEV-PAID" [shape=ellipse style="filled" peripheries=1 fillcolor="#e6e6e6" color="#555555" label="Payment recorded in the\nbooks (JEV: Accounts\nPayable, Cash-MDS, Due\nto BIR)" tooltip="S-JEV-PAID"]
"C-F069-PAYMENT" [shape=ellipse style="filled,dashed" peripheries=1 fillcolor="#e6e6e6" color="#555555" label="F069: Copy of the daily\nreport and JEV of the\npayment, at the budget\nunit" tooltip="C-F069-PAYMENT"]
"C-F023" [shape=ellipse style="filled,dashed" peripheries=1 fillcolor="#e6e6e6" color="#555555" label="F023: Paid vouchers with\nthe daily report and\nJEV, at the COA auditor" tooltip="C-F023"]
"C-F035" [shape=ellipse style="filled,dashed" peripheries=1 fillcolor="#e6e6e6" color="#555555" label="F035: Returns of taxes\nwithheld and the\nelectronic Tax\nRemittance Advice, at\nBIR" tooltip="C-F035"]
"S-ORS-PAID" [shape=ellipse style="filled" peripheries=1 fillcolor="#e6e6e6" color="#555555" label="Payment posted in part C\nof the ORS and in the\nregistry of\ndisbursements" tooltip="S-ORS-PAID"]
"S-AUDITED" [shape=ellipse style="filled" peripheries=1 fillcolor="#e6e6e6" color="#555555" label="Audit result: no\nfinding, or an\nobservation, suspension,\ndisallowance or charge" tooltip="S-AUDITED"]
"S-MONTH-END" [shape=ellipse style="filled" peripheries=1 fillcolor="#e6e6e6" color="#555555" label="End of a month ●" tooltip="S-MONTH-END"]
"C-F034" [shape=ellipse style="filled,dashed" peripheries=1 fillcolor="#e6e6e6" color="#555555" label="F034: Monthly bank\nstatement, at accounting" tooltip="C-F034"]
"S-RECONCILED" [shape=ellipse style="filled" peripheries=1 fillcolor="#e6e6e6" color="#555555" label="Books, registries and\nbank agree for the\nperiod" tooltip="S-RECONCILED"]
"SP-01" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="SP-01\nIssue the NCA" tooltip="DBM (bureaus and approving officials)"]
"SP-02" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="SP-02\nCredit the NCA to the\nMDS sub-account" tooltip="Servicing bank"]
"SP-03" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="SP-03\nRecord the NCA received" tooltip="Chief accountant (head of the accounting unit)"]
"SP-05" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="SP-05\nObligate and sign the\ncontract" tooltip="Head of the budget unit"]
"SP-06" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="SP-06\nDeliver" tooltip="Supplier or contractor"]
"SP-07" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="SP-07\nInspect and accept" tooltip="Inspection officer and property custodian"]
"SP-08" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="SP-08\nRecord the payable" tooltip="Chief accountant (head of the accounting unit)"]
"SP-08B" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="SP-08B\nPost the payable in part\nC of the ORS" tooltip="Head of the budget unit"]
"SP-09" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="SP-09\nPrepare and examine the\nclaim" tooltip="Chief accountant (head of the accounting unit)"]
"SP-10" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="SP-10\nCertify cash available\nand approve" tooltip="Chief accountant (head of the accounting unit)"]
"SP-11" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="SP-11\nPrepare and sign the\npayment order" tooltip="Cashier or disbursing officer"]
"SP-12A" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="SP-12A\nSend the payment order\non paper" tooltip="Cashier or disbursing officer"]
"SP-12B" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="SP-12B\nSend the payment order\nthrough eMDS" tooltip="Cashier or disbursing officer"]
"SP-13A" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="SP-13A\nCheck and pay the paper\norder" tooltip="Servicing bank"]
"SP-13B" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="SP-13B\nCheck and pay the eMDS\norder" tooltip="Servicing bank"]
"SP-14" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="SP-14\nReplenish the servicing\nbank" tooltip="Bureau of the Treasury"]
"SP-15" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="SP-15\nReceive the\nreplenishment" tooltip="Servicing bank"]
"SP-16" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="SP-16\nReceive the validated\ncopy and prepare the\ndaily report" tooltip="Cashier or disbursing officer"]
"SP-17" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="SP-17\nRecord the payment in\nthe books" tooltip="Chief accountant (head of the accounting unit)"]
"SP-18" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="SP-18\nPost the payment in the\nORS and the registry" tooltip="Head of the budget unit"]
"SP-19" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="SP-19\nAudit the paid\ntransaction" tooltip="COA audit team"]
"SP-20" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="SP-20\nSend the monthly bank\nstatement" tooltip="Servicing bank"]
"SP-21" [shape=box style="filled" fillcolor="#ffffff" penwidth=1.6 label="SP-21\nReconcile books,\nregistries and bank for\nthe month" tooltip="Chief accountant (head of the accounting unit)"]
