      <place id="S-NCA-BANK"><name><text>NCA balance in the MDS sub-account at the servicing bank (a limit, not cash)</text></name></place>
      <place id="S-NCA-AGENCY"><name><text>NCA balance as recorded by the agency (registry of the accounting unit)</text></name></place>
      <place id="S-ALLOT"><name><text>Allotment available, not yet obligated</text></name><initialMarking><text>1</text></initialMarking></place>
