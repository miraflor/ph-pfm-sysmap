      <place id="S-CLAIM-APPROVED"><name><text>Claim approved for payment: Box C certified and Box D approved</text></name></place>
      <place id="C-F027"><name><text>Instruction for an electronic payment from BTMS, through the bank</text></name></place>
      <place id="S-JEV-PAID"><name><text>Payment recorded in the books (JEV: Accounts Payable, Cash-MDS, Due to BIR)</text></name></place>
      <place id="S-ORS-PAID"><name><text>Payment posted in part C of the ORS and in the registry of disbursements</text></name></place>
      <place id="C-F127"><name><text>Payee credited through PESONet or InstaPay</text></name></place>
      <place id="S-BANK-CLAIM"><name><text>Payments made by the bank, to be replenished</text></name></place>
      <place id="C-F061"><name><text>Report of payments made, at eTRAMS of BTr</text></name></place>
      <place id="C-F028"><name><text>Electronic bank statement, at BTMS</text></name></place>
      <place id="C-F020"><name><text>Replenishment on its way from the TSA to the bank</text></name></place>
      <place id="S-SETTLED"><name><text>Bank replenished for the payments it made</text></name></place>
      <place id="S-RECONCILED"><name><text>Books, registries and bank agree for the period</text></name></place>
      <place id="C-F012-BED"><name><text>Budget execution documents entered in URS</text></name></place>
      <place id="S-NBC"><name><text>Release guidelines of the year issued (National Budget Circular)</text></name><initialMarking><text>1</text></initialMarking></place>
      <place id="C-F021A-BED"><name><text>Budget execution documents at DBM for evaluation</text></name></place>
      <place id="S-APPROP"><name><text>Appropriation available (a line of the GAA)</text></name><initialMarking><text>1</text></initialMarking></place>
      <place id="S-SBR"><name><text>Special Budget Request submitted for an item that needs clearance</text></name></place>
      <place id="S-SBR-CLEARED"><name><text>Request ready for evaluation (approved by the Office of the President where the guidelines require it)</text></name></place>
      <place id="C-F007"><name><text>Approved release document passed to ADRS</text></name></place>
      <place id="C-F008-SARO"><name><text>SARO or GARO available for download by the agency</text></name></place>
      <place id="C-F009"><name><text>Record of the issued document sent to the verification record</text></name></place>
      <place id="S-VERIFIABLE"><name><text>Fingerprint of the document stored; any copy can be checked</text></name></place>
      <place id="C-F041"><name><text>Annual Procurement Plan and monitoring report at the GPPB</text></name></place>
      <place id="S-NEED"><name><text>Need ready: purchase request and a line in the procurement plan</text></name><initialMarking><text>1</text></initialMarking></place>
      <place id="C-F013-ITB"><name><text>Invitation to bid posted in PhilGEPS</text></name></place>
      <place id="C-F014"><name><text>Opportunity visible to registered suppliers</text></name></place>
      <place id="C-F103"><name><text>Notice and award in the open data of PhilGEPS</text></name></place>
      <place id="S-BIDS"><name><text>Bids received and opened</text></name></place>
      <place id="C-F013-NOA"><name><text>Award posted in PhilGEPS</text></name></place>
      <place id="C-F026"><name><text>Procurement data passed to BTMS</text></name></place>
      <place id="S-FEE-DUE"><name><text>A fee is due from a payer (order of payment issued)</text></name><initialMarking><text>1</text></initialMarking></place>
      <place id="C-F064"><name><text>Fee paid to the collecting officer</text></name></place>
      <place id="S-CASH-ON-HAND"><name><text>Collections in the hands of the collecting officer</text></name></place>
      <place id="S-OR-ISSUED"><name><text>Official receipt issued and listed</text></name></place>
      <place id="C-F049"><name><text>Collections deposited at the depository bank</text></name></place>
      <place id="C-F050"><name><text>Report of collections and deposits, at accounting</text></name></place>
      <place id="S-AGDB-BAL"><name><text>Collections in the account at the depository bank</text></name></place>
      <place id="C-F051"><name><text>Collection reports of the bank, at NGCDS</text></name></place>
      <place id="C-F065"><name><text>Consolidated report of daily collections and credit memo, at accounting</text></name></place>
      <place id="S-JEV-COLL"><name><text>Collections recorded in the books of the agency</text></name></place>
      <place id="C-F052"><name><text>Balances on their way to the TSA</text></name></place>
      <place id="C-F053"><name><text>Collections data at eTRAMS</text></name></place>
      <place id="C-F054"><name><text>Certificate of deposited national collections, at the agency</text></name></place>
      <place id="S-TAX-DUE"><name><text>A tax return is due</text></name><initialMarking><text>1</text></initialMarking></place>
      <place id="C-F042"><name><text>Return filed in eFPS or eBIRForms</text></name></place>
      <place id="S-TO-PAY"><name><text>Tax filed and to be paid</text></name></place>
      <place id="C-F043"><name><text>Tax paid at an agent bank or gateway</text></name></place>
      <place id="C-F044"><name><text>Return in the internal system of BIR</text></name></place>
      <place id="C-F045"><name><text>Report of payments received, at BIR</text></name></place>
      <place id="S-AAB-COLL"><name><text>Collections held by the agent bank before remittance</text></name></place>
      <place id="S-TAX-POSTED"><name><text>Payment posted to the account of the taxpayer</text></name></place>
      <place id="C-F048"><name><text>Collections on their way to the TSA</text></name></place>
      <place id="S-IMPORT"><name><text>Goods arrive for import</text></name><initialMarking><text>1</text></initialMarking></place>
      <place id="C-F046"><name><text>Goods declaration in E2M</text></name></place>
      <place id="S-ASSESSED"><name><text>Duties and taxes assessed</text></name></place>
      <place id="C-F043-CUSTOMS"><name><text>Duties paid at an agent bank</text></name></place>
      <place id="C-F047"><name><text>Abstract of collection, through PAS, at BOC</text></name></place>
      <place id="S-RELEASED"><name><text>Goods released</text></name></place>
      <place id="S-FIN-NEED"><name><text>Financing need in the borrowing program</text></name><initialMarking><text>1</text></initialMarking></place>
      <place id="C-F056"><name><text>Bids in NRoSS</text></name></place>
      <place id="C-F057"><name><text>Settlement instruction at the BSP settlement system</text></name></place>
      <place id="C-F058"><name><text>Proceeds on their way to the TSA</text></name></place>
      <place id="S-ISSUED"><name><text>Securities registered to the buyers</text></name></place>
      <place id="C-F059"><name><text>New debt passed to the debt and accounting systems of BTr</text></name></place>
      <place id="S-DEBT-RECORDED"><name><text>Debt recorded by BTr</text></name></place>
      <place id="S-DEBT-DUE"><name><text>Interest or principal falls due</text></name></place>
      <place id="C-F060"><name><text>Interest and principal paid to holders</text></name></place>
      <place id="C-F124"><name><text>BTMS reports at DBM</text></name></place>
      <place id="C-F125"><name><text>BTMS reports at COA</text></name></place>
      <place id="C-F126"><name><text>BTMS reports at BTr</text></name></place>
      <place id="C-F022"><name><text>Financial statements in the AFR System</text></name></place>
      <place id="S-AFR"><name><text>Annual Financial Report of the government prepared by COA</text></name></place>
      <place id="C-F029"><name><text>Agency submission in COMPASS</text></name></place>
      <place id="C-F030"><name><text>Data from BTMS in COMPASS</text></name></place>
      <place id="C-F031"><name><text>Budget and spending figures visible to any person</text></name></place>
      <place id="S-PIP-CALL"><name><text>Joint call for the PIP and TRIP issued</text></name><initialMarking><text>1</text></initialMarking></place>
      <place id="C-F001"><name><text>Programs and projects encoded and endorsed in PIPOL</text></name></place>
      <place id="S-PIP-ENTRY"><name><text>Entry validated in the PIP or TRIP</text></name></place>
      <place id="S-BUDGET-CALL"><name><text>Budget Call issued</text></name><initialMarking><text>1</text></initialMarking></place>
      <place id="C-F003"><name><text>Budget proposal forms in OSBPS</text></name></place>
      <place id="S-POSITIONS"><name><text>Monthly update of positions due</text></name><initialMarking><text>1</text></initialMarking></place>
      <place id="C-F004"><name><text>Updated positions in GMIS</text></name></place>
      <place id="C-F005A"><name><text>Proposals in BPMS</text></name></place>
      <place id="C-F005B"><name><text>Filled positions in BPMS</text></name></place>
      <place id="S-NEP"><name><text>National Expenditure Program submitted to Congress</text></name></place>
      <place id="S-GAA"><name><text>General Appropriations Act signed</text></name></place>
      <place id="C-F006"><name><text>Enacted budget in the e-Budget of DBM</text></name></place>
      <transition id="SP-01"><name><text>Issue the NCA</text></name></transition>
      <transition id="SP-02"><name><text>Credit the NCA to the MDS sub-account</text></name></transition>
      <transition id="SP-03"><name><text>Record the NCA received</text></name></transition>
      <transition id="SP-05"><name><text>Obligate and sign the contract</text></name></transition>
      <transition id="SP-06"><name><text>Deliver</text></name></transition>
      <transition id="SP-07"><name><text>Inspect and accept</text></name></transition>
      <transition id="SP-09"><name><text>Prepare and examine the claim</text></name></transition>
      <transition id="SP-10"><name><text>Certify cash available and approve</text></name></transition>
      <transition id="SP-12C"><name><text>Pay through BTMS</text></name></transition>
      <transition id="SP-13C"><name><text>Debit the sub-account and pass the transfer to the clearing house</text></name></transition>
      <transition id="SP-14"><name><text>Replenish the servicing bank</text></name></transition>
      <transition id="SP-15"><name><text>Receive the replenishment</text></name></transition>
      <transition id="SP-21B"><name><text>Reconcile each day from electronic statements</text></name></transition>
      <transition id="RL-01"><name><text>Submit the budget execution documents in URS</text></name></transition>
      <transition id="RL-02"><name><text>Pass the documents to DBM</text></name></transition>
      <transition id="RL-03A"><name><text>Release by the GAA as allotment order</text></name></transition>
      <transition id="RL-03B"><name><text>Submit a Special Budget Request</text></name></transition>
      <transition id="RL-04A"><name><text>Obtain the approval of the Office of the President</text></name></transition>
      <transition id="RL-04B"><name><text>No approval of the President needed</text></name></transition>
      <transition id="RL-05"><name><text>Evaluate and approve the SARO or GARO</text></name></transition>
      <transition id="RL-06"><name><text>Release the document in ADRS</text></name></transition>
      <transition id="RL-07"><name><text>Download and record the allotment</text></name></transition>
      <transition id="RL-08"><name><text>Store the fingerprint of the document</text></name></transition>
      <transition id="PR-01"><name><text>Submit the procurement plan and monitoring report</text></name></transition>
      <transition id="PR-02"><name><text>Post the invitation to bid</text></name></transition>
      <transition id="PR-03"><name><text>Show the opportunity and publish open data</text></name></transition>
      <transition id="PR-04"><name><text>Submit and open the bids</text></name></transition>
      <transition id="PR-05"><name><text>Evaluate, recommend and award</text></name></transition>
      <transition id="PR-06"><name><text>Pass procurement data to BTMS (planned)</text></name></transition>
      <transition id="CO-01"><name><text>Pay the fee</text></name></transition>
      <transition id="CO-02"><name><text>Issue the official receipt</text></name></transition>
      <transition id="CO-03"><name><text>Deposit the collections in full</text></name></transition>
      <transition id="CO-04"><name><text>Report collections and deposits for the day</text></name></transition>
      <transition id="CO-05"><name><text>Credit the account and report</text></name></transition>
      <transition id="CO-06"><name><text>Record the collections</text></name></transition>
      <transition id="CO-07"><name><text>Transfer the balances to the TSA</text></name></transition>
      <transition id="CO-08"><name><text>Consolidate the collection reports</text></name></transition>
      <transition id="CO-09"><name><text>Issue the certificate of deposited collections</text></name></transition>
      <transition id="TX-01"><name><text>File the return</text></name></transition>
      <transition id="TX-02"><name><text>Pay the tax</text></name></transition>
      <transition id="TX-03"><name><text>Pass the return to the internal system</text></name></transition>
      <transition id="TX-04"><name><text>Confirm and report the payment</text></name></transition>
      <transition id="TX-05"><name><text>Post the payment to the taxpayer account</text></name></transition>
      <transition id="TX-06"><name><text>Remit the collections to the TSA</text></name></transition>
      <transition id="TX-07"><name><text>Credit the TSA</text></name></transition>
      <transition id="TX-11"><name><text>Declare the goods</text></name></transition>
      <transition id="TX-12"><name><text>Assess duties and taxes</text></name></transition>
      <transition id="TX-13"><name><text>Pay the assessed amount</text></name></transition>
      <transition id="TX-14"><name><text>Send the abstract of collection through PAS</text></name></transition>
      <transition id="TX-15"><name><text>Confirm the payment and release the goods</text></name></transition>
      <transition id="DB-01"><name><text>Bid in the auction</text></name></transition>
      <transition id="DB-02"><name><text>Award and send the settlement instruction</text></name></transition>
      <transition id="DB-03"><name><text>Settle securities against payment</text></name></transition>
      <transition id="DB-04"><name><text>Credit the proceeds to the TSA</text></name></transition>
      <transition id="DB-05"><name><text>Record the new debt</text></name></transition>
      <transition id="DB-06"><name><text>Pay interest and principal</text></name></transition>
      <transition id="RP-03"><name><text>Produce the reports from BTMS records</text></name></transition>
      <transition id="RP-04"><name><text>Submit the financial statements</text></name></transition>
      <transition id="RP-05"><name><text>Prepare the Annual Financial Report</text></name></transition>
      <transition id="RP-06"><name><text>Submit information to COMPASS</text></name></transition>
      <transition id="RP-07"><name><text>Pass BTMS data to COMPASS (described)</text></name></transition>
      <transition id="RP-08"><name><text>Publish budget and spending figures</text></name></transition>
      <transition id="PL-01"><name><text>Encode and endorse programs and projects in PIPOL</text></name></transition>
      <transition id="PL-02"><name><text>Validate the entries against the PIP criteria</text></name></transition>
      <transition id="PL-03"><name><text>Enter the budget proposal in OSBPS</text></name></transition>
      <transition id="PL-04"><name><text>Update the positions in GMIS</text></name></transition>
      <transition id="PL-05"><name><text>Build the proposed budget</text></name></transition>
      <transition id="PL-06"><name><text>Enact the budget</text></name></transition>
      <transition id="PL-07"><name><text>Load the enacted budget in the e-Budget of DBM</text></name></transition>
      <transition id="PL-08"><name><text>Make the appropriation available for release</text></name></transition>
