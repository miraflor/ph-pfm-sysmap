"t01" [shape=box style=rounded label="1. Taxpayers and importers to eFPS and\neBIRForms: File the return electronically" tooltip="10b-01"]
"t02" [shape=box style=rounded label="2. Taxpayers and importers to Agent banks and\ngateways: Pay: bank debit, online gateway, at\na bank branch, or to a revenue collection\nofficer where there is no bank" tooltip="10b-02"]
"t03" [shape=box style=rounded label="3. Agent banks and gateways to Taxpayers and\nimporters: Payment confirmation" tooltip="10b-03"]
"t04" [shape=box style=rounded label="4. Agent banks and gateways to eFPS and\neBIRForms: Report of payments received" tooltip="10b-04"]
"t05" [shape=box style=rounded label="5. eFPS and eBIRForms: Post the payment to the\ntaxpayer account" tooltip="10b-05"]
"t06" [shape=box style=rounded label="6. Taxpayers and importers to E2M customs\nsystem: Goods declaration" tooltip="10b-06"]
"t07" [shape=box style=rounded label="7. E2M customs system to Taxpayers and\nimporters: Assessment of duties and taxes" tooltip="10b-07"]
