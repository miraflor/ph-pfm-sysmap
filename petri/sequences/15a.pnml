<?xml version="1.0" encoding="UTF-8"?>
<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml">
  <net id="SEQ-15a" type="http://www.pnml.org/version-2009/grammar/ptnet">
    <name><text>15a Government corporations (GOCCs): corporate operating budget, budgetary support and reports</text></name>
    <page id="page1">
      <place id="p1"><name><text>start</text></name><initialMarking><text>1</text></initialMarking></place>
      <place id="p2"><name><text>p2</text></name></place>
      <place id="p3"><name><text>p3</text></name></place>
      <place id="p4"><name><text>p4</text></name></place>
      <place id="p5"><name><text>p5</text></name></place>
      <place id="p6"><name><text>p6</text></name></place>
      <place id="p7"><name><text>p7</text></name></place>
      <place id="p8"><name><text>p8</text></name></place>
      <place id="p9"><name><text>p9</text></name></place>
      <place id="p10"><name><text>p10</text></name></place>
      <place id="p11"><name><text>p11</text></name></place>
      <place id="p12"><name><text>p12</text></name></place>
      <place id="p13"><name><text>p13</text></name></place>
      <place id="p14"><name><text>p14</text></name></place>
      <place id="p15"><name><text>p15</text></name></place>
      <place id="p16"><name><text>p16</text></name></place>
      <place id="p17"><name><text>p17</text></name></place>
      <place id="p18"><name><text>p18</text></name></place>
      <place id="p19"><name><text>end</text></name></place>
      <transition id="t01"><name><text>1. GOCC management to GOCC board: Proposed COB</text></name></transition>
      <transition id="t02"><name><text>2. GOCC board to GOCC management: Board approval</text></name></transition>
      <transition id="t03"><name><text>3. GOCC management to DBM: COB on or before 31 March, with DBM Forms 700, 703-A to 703-C, 705, 706</text></name></transition>
      <transition id="t04"><name><text>4. DBM: Evaluate: uses agree with the board approval, sources cover uses, national priorities, physical performance, use of last year's budget, financial ratios</text></name></transition>
      <transition id="t05"><name><text>5. DBM to GOCC management: COB approval letter (within 20 working days)</text></name></transition>
      <transition id="t06"><name><text>6. GOCC management to DBM: Request for subsidy or equity in the national budget proposal</text></name></transition>
      <transition id="t07"><name><text>7. Congress to DBM: GAA item "Budgetary Support to Government Corporations"</text></name></transition>
      <transition id="t08"><name><text>8. GOCC management to DBM: Special Budget Request. The amount must be in the board-approved COB</text></name></transition>
      <transition id="t09"><name><text>9. DBM to BTr: Release document</text></name></transition>
      <transition id="t10"><name><text>10. BTr to GOCC management: Cash released directly to the corporation</text></name></transition>
      <transition id="tau1"><name><text>skip: The corporation owes the Treasury</text></name></transition>
      <transition id="t11"><name><text>11. BTr: Offset the release against dividends due, guarantee fees, advances and other receivables</text></name></transition>
      <transition id="tau2"><name><text>end of: The corporation owes the Treasury</text></name></transition>
      <transition id="t12"><name><text>12. GOCC management to BTr: Dividends: at least 50 percent of annual net earnings</text></name></transition>
      <transition id="t13"><name><text>13. GOCC management to DBM: Quarterly financial and physical reports through URS, within 30 days after each quarter. Also published on its website</text></name></transition>
      <transition id="t14"><name><text>14. GOCC management to Congress: Written notice that the reports were submitted and published</text></name></transition>
      <transition id="t15"><name><text>15. GOCC management to COA: Year-end financial statements by 14 February</text></name></transition>
      <transition id="t16"><name><text>16. COA to GOCC board: Audit report</text></name></transition>
      <transition id="t17"><name><text>17. GCG to GOCC board: Performance targets and evaluation of the corporation</text></name></transition>
      <arc id="a1" source="p1" target="t01"/>
