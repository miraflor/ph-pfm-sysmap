digraph seq {
graph [rankdir=TB nodesep=0.25 ranksep=0.3 fontname="Helvetica" label="16f  Public verification of DBM release documents with a blockchain record" labelloc=t fontsize=11]
node [fontname="Helvetica" fontsize=8]
edge [arrowsize=0.5]
"p1" [shape=circle width=0.25 fixedsize=true label="start" fontsize=6 style=filled fillcolor="#333333"]
"p2" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p3" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p4" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p5" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p6" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p7" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p8" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p9" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p10" [shape=circle width=0.25 fixedsize=true label="end" fontsize=6 style=filled fillcolor="#ffffff"]
"t01" [shape=box style=rounded label="1. DBM to ADRS: Approved release document\n(SARO, or advice of NCA)" tooltip="16f-01"]
"t02" [shape=box style=rounded label="2. ADRS to Document verification (blockchain):\nRecord of the issued document" tooltip="16f-02"]
"t03" [shape=box style=rounded label="3. Document verification (blockchain): Store a\nfingerprint of the document (a hash) with date\nand document number. The record cannot be\nchanged later" tooltip="16f-03"]
"t04" [shape=box style=rounded label="4. ADRS to National agency: Document for\ndownload, with a QR code" tooltip="16f-04"]
"t05" [shape=box style=rounded label="5. National agency to Any person: Copy of the\ndocument (for example to a contractor or a\nbank)" tooltip="16f-05"]
"t06" [shape=box style=rounded label="6. Any person to Document verification\n(blockchain): Scan the QR code, or enter the\ndocument reference" tooltip="16f-06"]
"t07" [shape=box style=rounded label="7. Document verification (blockchain) to\nDocument verification (blockchain): Retrieve\nthe record" tooltip="16f-07"]
"t08" [shape=box style=rounded label="8. Document verification (blockchain) to\nDocument verification (blockchain): Stored\nrecord" tooltip="16f-08"]
"t09" [shape=box style=rounded label="9. Document verification (blockchain) to Any\nperson: Result: the copy matches the issued\ndocument, or it does not" tooltip="16f-09"]
"p1" -> "t01"
"t01" -> "p2"
"p2" -> "t02"
"t02" -> "p3"
"p3" -> "t03"
"t03" -> "p4"
"p4" -> "t04"
"t04" -> "p5"
"p5" -> "t05"
"t05" -> "p6"
"p6" -> "t06"
"t06" -> "p7"
"p7" -> "t07"
"t07" -> "p8"
"p8" -> "t08"
"t08" -> "p9"
"p9" -> "t09"
"t09" -> "p10"
}