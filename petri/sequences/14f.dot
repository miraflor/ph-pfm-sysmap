digraph seq {
graph [rankdir=TB nodesep=0.25 ranksep=0.3 fontname="Helvetica" label="14f  The budget of a barangay: who prepares, who enacts, who reviews" labelloc=t fontsize=11]
node [fontname="Helvetica" fontsize=8]
edge [arrowsize=0.5]
"p1" [shape=circle width=0.25 fixedsize=true label="start" fontsize=6 style=filled fillcolor="#333333"]
"p2" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p3" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p4" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p5" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p6" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p7" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p8" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p9" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p10" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p11" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p12" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p13" [shape=circle width=0.25 fixedsize=true label="end" fontsize=6 style=filled fillcolor="#ffffff"]
"t01" [shape=box style=rounded label="1. Barangay to Barangay: Estimate of income\nfor the next year, and statements of income\nand expenditure, on or before 15 September" tooltip="14f-01"]
"t02" [shape=box style=rounded label="2. Barangay: Prepare the budget with the\ntreasurer. Mandatory items: 10 percent of the\ngeneral fund for the youth council, at least\n20 percent of the tax allotment for\ndevelopment, 5 percent of regular income for\ncalamities. Personal services at most 55\npercent of last year's income" tooltip="14f-02"]
"t03" [shape=box style=rounded label="3. Barangay to Barangay: Budget, on or before\n16 October" tooltip="14f-03"]
"t04" [shape=box style=rounded label="4. Barangay: Appropriation ordinance, by a\nmajority of all members. The punong barangay\nvotes only when the votes are equal and has no\nveto" tooltip="14f-04"]
"t05" [shape=box style=rounded label="5. Barangay to Local treasurer: Ordinance,\nwithin 10 days after enactment" tooltip="14f-05"]
"t06" [shape=box style=rounded label="6. Local treasurer to Sanggunian: Ordinance\nwith findings" tooltip="14f-06"]
"t07" [shape=box style=rounded label="7. Sanggunian: Review within 60 days: legal\nrequirements and limits are met,\nappropriations do not exceed estimated income" tooltip="14f-07"]
"t08" [shape=box style=rounded label="8. Sanggunian to Barangay: The ordinance is\ndeemed to be in full force" tooltip="14f-08"]
"tau1" [shape=box width=0.15 height=0.15 style=filled fillcolor="#444444" label="" tooltip="end of: No action within 60 days"]
"t09" [shape=box style=rounded label="9. Sanggunian to Barangay: Returned for\nadjustment. The treasurer may make no further\npayments from the inoperative part" tooltip="14f-09"]
"tau2" [shape=box width=0.15 height=0.15 style=filled fillcolor="#444444" label="" tooltip="end of: Found inoperative, in whole or in part"]
"t10" [shape=box style=rounded label="10. Barangay: Custody of the funds.\nCollections and payments" tooltip="14f-10"]
"t11" [shape=box style=rounded label="11. Barangay to Local treasurer: Records of\ntransactions. The accounts are kept in the\noffices of the barangay treasurer and of the\ncity or municipal accountant" tooltip="14f-11"]
"p1" -> "t01"
"t01" -> "p2"
"p2" -> "t02"
"t02" -> "p3"
"p3" -> "t03"
"t03" -> "p4"
"p4" -> "t04"
"t04" -> "p5"
"p5" -> "t05"
"t05" -> "p6"
"p6" -> "t06"
"t06" -> "p7"
"p7" -> "t07"
"t07" -> "p8"
"p8" -> "t08"
"t08" -> "p10"
"p10" -> "tau1"
"tau1" -> "p9"
"p8" -> "t09"
"t09" -> "p11"
"p11" -> "tau2"
"tau2" -> "p9"
"p9" -> "t10"
"t10" -> "p12"
"p12" -> "t11"
"t11" -> "p13"
}