<?xml version="1.0" encoding="UTF-8"?>
<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml">
  <net id="SEQ-01b" type="http://www.pnml.org/version-2009/grammar/ptnet">
    <name><text>01b Investment programming: how a project enters the PIP and TRIP and reaches the budget</text></name>
    <page id="page1">
      <place id="p1"><name><text>start</text></name><initialMarking><text>1</text></initialMarking></place>
      <place id="p2"><name><text>p2</text></name></place>
      <place id="p3"><name><text>p3</text></name></place>
      <place id="p4"><name><text>p4</text></name></place>
      <place id="p5"><name><text>p5</text></name></place>
      <place id="p6"><name><text>p6</text></name></place>
      <place id="p7"><name><text>p7</text></name></place>
      <place id="p8"><name><text>p8</text></name></place>
      <place id="p9"><name><text>p9</text></name></place>
      <place id="p10"><name><text>p10</text></name></place>
      <place id="p11"><name><text>p11</text></name></place>
      <place id="p12"><name><text>p12</text></name></place>
      <place id="p13"><name><text>p13</text></name></place>
      <place id="p14"><name><text>p14</text></name></place>
      <place id="p15"><name><text>p15</text></name></place>
      <place id="p16"><name><text>p16</text></name></place>
      <place id="p17"><name><text>end</text></name></place>
      <transition id="t01"><name><text>1. PIP and TRIP secretariats to National agency: Joint call to update the PIP and formulate the TRIP, with guidelines and calendar</text></name></transition>
      <transition id="t02"><name><text>2. Operating units to Regional Development Councils: Regional priority programs and projects</text></name></transition>
      <transition id="t03"><name><text>3. Regional Development Councils to Operating units: Endorsement, or recommendations</text></name></transition>
      <transition id="t04"><name><text>4. National agency to PIPOL: Reconfirm ongoing programs and projects. Encode new or updated ones: cost per year, physical and financial progress</text></name></transition>
      <transition id="t05"><name><text>5. National agency to PIPOL: Head of agency endorses the submission (example window: 8 November to 6 December 2024)</text></name></transition>
      <transition id="t06"><name><text>6. PIPOL to PIP and TRIP secretariats: Only submissions marked "as endorsed" are processed</text></name></transition>
      <transition id="t07"><name><text>7. PIP and TRIP secretariats: Check each entry against the PIP criteria and the scope of the TRIP</text></name></transition>
      <transition id="tau1"><name><text>skip: Project needs ICC review</text></name></transition>
      <transition id="t08"><name><text>8. National agency to ICC: Project proposal with feasibility study and financing plan</text></name></transition>
      <transition id="t09"><name><text>9. ICC: Technical, economic and financial appraisal</text></name></transition>
      <transition id="t10"><name><text>10. ICC to ED Council: Recommendation</text></name></transition>
      <transition id="t11"><name><text>11. ED Council to National agency: Approval or confirmation</text></name></transition>
      <transition id="tau2"><name><text>end of: Project needs ICC review</text></name></transition>
      <transition id="t12"><name><text>12. PIP and TRIP secretariats to DBM: PIP and TRIP as input to budget preparation</text></name></transition>
      <transition id="t13"><name><text>13. DBM to National agency: Budget Call. A Tier 2 proposal must be implementation-ready and must have the required endorsements and approvals</text></name></transition>
      <transition id="t14"><name><text>14. National agency to DBM: Tier 2 proposals in OSBPS (a different system from PIPOL)</text></name></transition>
      <transition id="t15"><name><text>15. National agency to PIPOL: After the budget is known, update yearly costs to match the GAA and the National Expenditure Program</text></name></transition>
      <arc id="a1" source="p1" target="t01"/>
      <arc id="a2" source="t01" target="p2"/>
