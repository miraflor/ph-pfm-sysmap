<?xml version="1.0" encoding="UTF-8"?>
<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml">
  <net id="SEQ-09a" type="http://www.pnml.org/version-2009/grammar/ptnet">
    <name><text>09a External audit by COA: from submission of accounts to the annual reports</text></name>
    <page id="page1">
      <place id="p1"><name><text>start</text></name><initialMarking><text>1</text></initialMarking></place>
      <place id="p2"><name><text>p2</text></name></place>
      <place id="p3"><name><text>p3</text></name></place>
      <place id="p4"><name><text>p4</text></name></place>
      <place id="p5"><name><text>p5</text></name></place>
      <place id="p6"><name><text>p6</text></name></place>
      <place id="p7"><name><text>p7</text></name></place>
      <place id="p8"><name><text>p8</text></name></place>
      <place id="p9"><name><text>p9</text></name></place>
      <place id="p10"><name><text>p10</text></name></place>
      <place id="p11"><name><text>p11</text></name></place>
      <place id="p12"><name><text>p12</text></name></place>
      <place id="p13"><name><text>p13</text></name></place>
      <place id="p14"><name><text>p14</text></name></place>
      <place id="p15"><name><text>p15</text></name></place>
      <place id="p16"><name><text>p16</text></name></place>
      <place id="p17"><name><text>p17</text></name></place>
      <place id="p18"><name><text>p18</text></name></place>
      <place id="p19"><name><text>p19</text></name></place>
      <place id="p20"><name><text>p20</text></name></place>
      <place id="p21"><name><text>end</text></name></place>
      <transition id="t01"><name><text>1. Accounting unit to COA audit team: Accounts: paid vouchers with the daily reports of payments, journal entries, reports. Year-end statements by 14 February</text></name></transition>
      <transition id="t02"><name><text>2. COA audit team: Audit: financial (are the statements fairly presented), compliance (were the rules followed), performance (were results achieved with economy)</text></name></transition>
      <transition id="t03"><name><text>3. COA audit team to Head of agency: Audit Observation Memorandum on each finding</text></name></transition>
      <transition id="t04"><name><text>4. Head of agency to COA audit team: Comments, explanations, documents</text></name></transition>
      <transition id="t05"><name><text>5. COA audit team to Head of agency: Notice of Suspension. The amount is suspended until the requirement is met</text></name></transition>
      <transition id="tau1"><name><text>end of: Finding on a transaction: a requirement is missing</text></name></transition>
      <transition id="t06"><name><text>6. COA audit team to Head of agency: Notice of Disallowance, naming the persons liable</text></name></transition>
      <transition id="tau2"><name><text>end of: Finding on a transaction: illegal, irregular, unnecessary, excessive or extravagant expense</text></name></transition>
      <transition id="t07"><name><text>7. COA audit team to Head of agency: Notice of Charge, naming the persons liable</text></name></transition>
      <transition id="tau3"><name><text>end of: Finding on revenue: under-assessment or under-collection</text></name></transition>
      <transition id="t08"><name><text>8. Head of agency to COA audit team: Requirement met, or amount returned</text></name></transition>
      <transition id="t09"><name><text>9. COA audit team to Head of agency: Notice of Settlement</text></name></transition>
      <transition id="tau4"><name><text>end of: Persons liable comply</text></name></transition>
      <transition id="t10"><name><text>10. Head of agency to COA directors: Appeal</text></name></transition>
      <transition id="t11"><name><text>11. COA directors to Head of agency: Decision</text></name></transition>
      <transition id="t12"><name><text>12. Head of agency to COA Commission Proper: Petition for review</text></name></transition>
      <transition id="t13"><name><text>13. COA Commission Proper to Head of agency: Decision of the Commission Proper</text></name></transition>
      <transition id="tau5"><name><text>end of: Persons liable contest</text></name></transition>
      <transition id="t14"><name><text>14. COA audit team to Head of agency: When a decision is final: Notice of Finality of Decision. The agency records a receivable from the persons liable. Then COA Order of Execution (for example, withholding of pay)</text></name></transition>
      <transition id="t15"><name><text>15. COA audit team to Head of agency: Each quarter: Statement of Audit Suspensions, Disallowances and Charges</text></name></transition>
      <transition id="t16"><name><text>16. COA audit team to Head of agency: Draft findings discussed. Then the audit report of the agency: opinion on the statements, observations and recommendations, status of earlier recommendations</text></name></transition>
      <transition id="t17"><name><text>17. Head of agency to COA audit team: Action plan on the recommendations</text></name></transition>
      <transition id="t18"><name><text>18. COA audit team to President: COA annual report on the financial condition and operation of the government, by 30 September</text></name></transition>
