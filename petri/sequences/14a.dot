"p8" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p9" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p10" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p11" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p12" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p13" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p14" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p15" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p16" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p17" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p18" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p19" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p20" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p21" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p22" [shape=circle width=0.25 fixedsize=true label="end" fontsize=6 style=filled fillcolor="#ffffff"]
"t01" [shape=box style=rounded label="1. Local chief executive to Local finance\ncommittee: Annual investment program from the\napproved local development plan" tooltip="14a-01"]
"t02" [shape=box style=rounded label="2. Local finance committee to Local chief\nexecutive: Income estimate and recommended\nspending ceiling by sector, based on the\napproved local plans" tooltip="14a-02"]
"t03" [shape=box style=rounded label="3. Local chief executive to National agency:\nBudget call with the ceilings" tooltip="14a-03"]
"t04" [shape=box style=rounded label="4. Local treasurer to Local chief executive:\nStatements of income and expenditures" tooltip="14a-04"]
"t05" [shape=box style=rounded label="5. National agency to Local chief executive:\nBudget proposals, on or before 15 July" tooltip="14a-05"]
"t06" [shape=box style=rounded label="6. Local chief executive to Local finance\ncommittee: Review and budget hearings" tooltip="14a-06"]
"t07" [shape=box style=rounded label="7. Local chief executive to Sanggunian:\nExecutive budget, not later than 16 October" tooltip="14a-07"]
"t08" [shape=box style=rounded label="8. Sanggunian: Enact the appropriation\nordinance on or before the end of the current\nfiscal year, within the legal limits (see 14b)" tooltip="14a-08"]
"t09" [shape=box style=rounded label="9. Sanggunian to Local chief executive:\nOrdinance for approval" tooltip="14a-09"]
"t10" [shape=box style=rounded label="10. Sanggunian: Stay in session, with no other\nbusiness. After 90 days the ordinance of the\nprevious year is deemed reenacted, only for\nsalaries, statutory and contractual\nobligations, and essential operating expenses" tooltip="14a-10"]
"tau1" [shape=box width=0.15 height=0.15 style=filled fillcolor="#444444" label="" tooltip="end of: No ordinance at the start of the fiscal year"]
"t11" [shape=box style=rounded label="11. Sanggunian to Sanggunian: Copy of the\nordinance. DBM reviews provinces, highly\nurbanized cities, independent component\ncities, and municipalities in Metro Manila.\nThe provincial sanggunian reviews component\ncities and municipalities" tooltip="14a-11"]
"t12" [shape=box style=rounded label="12. Sanggunian to Sanggunian: The ordinance is\ndeemed reviewed and stays in full force" tooltip="14a-12"]
"tau2" [shape=box width=0.15 height=0.15 style=filled fillcolor="#444444" label="" tooltip="end of: No action within 90 days"]
"t13" [shape=box style=rounded label="13. Sanggunian to Sanggunian: Ordinance\ndeclared inoperative in whole or in part. The\ntreasurer may not pay from those items" tooltip="14a-13"]
"tau3" [shape=box width=0.15 height=0.15 style=filled fillcolor="#444444" label="" tooltip="end of: Items exceed the legal limits"]
"t14" [shape=box style=rounded label="14. Local treasurer: Release allotments.\nCollect local taxes and fees" tooltip="14a-14"]
"t15" [shape=box style=rounded label="15. BTr to Local treasurer: National Tax\nAllotment released automatically and directly\nto the treasurer (BTr)" tooltip="14a-15"]
"t16" [shape=box style=rounded label="16. Local treasurer: Before each payment:\nbudget officer certifies the appropriation,\naccountant obligates it, treasurer certifies\navailable funds" tooltip="14a-16"]
"t17" [shape=box style=rounded label="17. National agency to Local chief executive:\nVoucher certified and approved by the head of\nthe department. The local chief executive also\napproves it, except for regularly recurring\nadministrative expenses (payrolls, utilities,\nremittances)" tooltip="14a-17"]
"t18" [shape=box style=rounded label="18. Local treasurer to eSRE: Statement of\nreceipts and expenditures to BLGF (eSRE),\nquarterly and annual. Accounts to COA" tooltip="14a-18"]
"t19" [shape=box style=rounded label="19. COA to Local chief executive: COA audit\nreport" tooltip="14a-19"]
"p1" -> "t01"
