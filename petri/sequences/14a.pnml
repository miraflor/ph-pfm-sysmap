<?xml version="1.0" encoding="UTF-8"?>
<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml">
  <net id="SEQ-14a" type="http://www.pnml.org/version-2009/grammar/ptnet">
    <name><text>14a Budget cycle of a local government unit (province, city or municipality) under the Local Government Code</text></name>
    <page id="page1">
      <place id="p1"><name><text>start</text></name><initialMarking><text>1</text></initialMarking></place>
      <place id="p2"><name><text>p2</text></name></place>
      <place id="p3"><name><text>p3</text></name></place>
      <place id="p4"><name><text>p4</text></name></place>
      <place id="p5"><name><text>p5</text></name></place>
      <place id="p6"><name><text>p6</text></name></place>
      <place id="p7"><name><text>p7</text></name></place>
      <place id="p8"><name><text>p8</text></name></place>
      <place id="p9"><name><text>p9</text></name></place>
      <place id="p10"><name><text>p10</text></name></place>
      <place id="p11"><name><text>p11</text></name></place>
      <place id="p12"><name><text>p12</text></name></place>
      <place id="p13"><name><text>p13</text></name></place>
      <place id="p14"><name><text>p14</text></name></place>
      <place id="p15"><name><text>p15</text></name></place>
      <place id="p16"><name><text>p16</text></name></place>
      <place id="p17"><name><text>p17</text></name></place>
      <place id="p18"><name><text>p18</text></name></place>
      <place id="p19"><name><text>p19</text></name></place>
      <place id="p20"><name><text>p20</text></name></place>
      <place id="p21"><name><text>p21</text></name></place>
      <place id="p22"><name><text>end</text></name></place>
      <transition id="t01"><name><text>1. Local chief executive to Local finance committee: Annual investment program from the approved local development plan</text></name></transition>
      <transition id="t02"><name><text>2. Local finance committee to Local chief executive: Income estimate and recommended spending ceiling by sector, based on the approved local plans</text></name></transition>
      <transition id="t03"><name><text>3. Local chief executive to National agency: Budget call with the ceilings</text></name></transition>
      <transition id="t04"><name><text>4. Local treasurer to Local chief executive: Statements of income and expenditures</text></name></transition>
      <transition id="t05"><name><text>5. National agency to Local chief executive: Budget proposals, on or before 15 July</text></name></transition>
      <transition id="t06"><name><text>6. Local chief executive to Local finance committee: Review and budget hearings</text></name></transition>
      <transition id="t07"><name><text>7. Local chief executive to Sanggunian: Executive budget, not later than 16 October</text></name></transition>
      <transition id="t08"><name><text>8. Sanggunian: Enact the appropriation ordinance on or before the end of the current fiscal year, within the legal limits (see 14b)</text></name></transition>
      <transition id="t09"><name><text>9. Sanggunian to Local chief executive: Ordinance for approval</text></name></transition>
      <transition id="t10"><name><text>10. Sanggunian: Stay in session, with no other business. After 90 days the ordinance of the previous year is deemed reenacted, only for salaries, statutory and contractual obligations, and essential operating expenses</text></name></transition>
      <transition id="tau1"><name><text>end of: No ordinance at the start of the fiscal year</text></name></transition>
      <transition id="t11"><name><text>11. Sanggunian to Sanggunian: Copy of the ordinance. DBM reviews provinces, highly urbanized cities, independent component cities, and municipalities in Metro Manila. The provincial sanggunian reviews component cities and municipalities</text></name></transition>
      <transition id="t12"><name><text>12. Sanggunian to Sanggunian: The ordinance is deemed reviewed and stays in full force</text></name></transition>
      <transition id="tau2"><name><text>end of: No action within 90 days</text></name></transition>
      <transition id="t13"><name><text>13. Sanggunian to Sanggunian: Ordinance declared inoperative in whole or in part. The treasurer may not pay from those items</text></name></transition>
      <transition id="tau3"><name><text>end of: Items exceed the legal limits</text></name></transition>
      <transition id="t14"><name><text>14. Local treasurer: Release allotments. Collect local taxes and fees</text></name></transition>
      <transition id="t15"><name><text>15. BTr to Local treasurer: National Tax Allotment released automatically and directly to the treasurer (BTr)</text></name></transition>
      <transition id="t16"><name><text>16. Local treasurer: Before each payment: budget officer certifies the appropriation, accountant obligates it, treasurer certifies available funds</text></name></transition>
      <transition id="t17"><name><text>17. National agency to Local chief executive: Voucher certified and approved by the head of the department. The local chief executive also approves it, except for regularly recurring administrative expenses (payrolls, utilities, remittances)</text></name></transition>
      <transition id="t18"><name><text>18. Local treasurer to eSRE: Statement of receipts and expenditures to BLGF (eSRE), quarterly and annual. Accounts to COA</text></name></transition>
      <transition id="t19"><name><text>19. COA to Local chief executive: COA audit report</text></name></transition>
