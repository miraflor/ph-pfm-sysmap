digraph seq {
graph [rankdir=TB nodesep=0.25 ranksep=0.3 fontname="Helvetica" label="12a  Personnel spending: from an authorized position to the monthly payroll and the remittances" labelloc=t fontsize=11]
node [fontname="Helvetica" fontsize=8]
edge [arrowsize=0.5]
