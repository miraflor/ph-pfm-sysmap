<?xml version="1.0" encoding="UTF-8"?>
<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml">
  <net id="SEQ-05a" type="http://www.pnml.org/version-2009/grammar/ptnet">
    <name><text>05a Release of funds: two separate authorities, allotment (to commit) and cash authority (to pay). Example: FY 2026</text></name>
    <page id="page1">
      <place id="p1"><name><text>start</text></name><initialMarking><text>1</text></initialMarking></place>
      <place id="p2"><name><text>p2</text></name></place>
      <place id="p3"><name><text>p3</text></name></place>
      <place id="p4"><name><text>p4</text></name></place>
      <place id="p5"><name><text>p5</text></name></place>
      <place id="p6"><name><text>p6</text></name></place>
      <place id="p7"><name><text>p7</text></name></place>
      <place id="p8"><name><text>p8</text></name></place>
      <place id="p9"><name><text>p9</text></name></place>
      <place id="p10"><name><text>p10</text></name></place>
      <place id="p11"><name><text>p11</text></name></place>
      <place id="p12"><name><text>p12</text></name></place>
      <place id="p13"><name><text>p13</text></name></place>
      <place id="p14"><name><text>p14</text></name></place>
      <place id="p15"><name><text>p15</text></name></place>
      <place id="p16"><name><text>p16</text></name></place>
      <place id="p17"><name><text>p17</text></name></place>
      <place id="p18"><name><text>p18</text></name></place>
      <place id="p19"><name><text>p19</text></name></place>
      <place id="p20"><name><text>p20</text></name></place>
      <place id="p21"><name><text>p21</text></name></place>
      <place id="p22"><name><text>p22</text></name></place>
      <place id="p23"><name><text>end</text></name></place>
      <transition id="t01"><name><text>1. DBM to National agency: Release guidelines for the year (National Budget Circular)</text></name></transition>
      <transition id="t02"><name><text>2. National agency to URS: Budget execution documents: BED 1 Financial Plan, BED 2 Physical Plan, BED 3 Monthly Disbursement Program</text></name></transition>
      <transition id="t03"><name><text>3. URS to DBM: Documents for evaluation</text></name></transition>
      <transition id="t04"><name><text>4. DBM to Operating units: No separate document. The GAA itself is the allotment order (GAAAO). Items appropriated to a regional office or operating unit go directly to it</text></name></transition>
      <transition id="tau1"><name><text>end of: Item without pre-conditions (Schedule I). Example: salaries of filled positions</text></name></transition>
      <transition id="t05"><name><text>5. National agency to DBM: Special Budget Request with details: project profile, location, cost, certifications</text></name></transition>
      <transition id="tau2"><name><text>skip: Item for which the guidelines require it</text></name></transition>
      <transition id="t06"><name><text>6. DBM to Office of the President: Request for approval</text></name></transition>
      <transition id="t07"><name><text>7. Office of the President to DBM: Approval</text></name></transition>
      <transition id="tau3"><name><text>end of: Item for which the guidelines require it</text></name></transition>
      <transition id="t08"><name><text>8. DBM: Evaluate: conditions of the GAA, readiness, past spending capacity of the agency</text></name></transition>
      <transition id="t09"><name><text>9. DBM to ADRS: Approved SARO (Special Allotment Release Order) or GARO (General Allotment Release Order)</text></name></transition>
      <transition id="t10"><name><text>10. ADRS to National agency: Authorized users of the agency download the document</text></name></transition>
      <transition id="tau4"><name><text>end of: Item that needs clearance (Schedule II). Examples: lump sums, new items, special purpose funds</text></name></transition>
      <transition id="t11"><name><text>11. National agency to Operating units: Sub-allotment to lower units, where the central office holds the allotment</text></name></transition>
      <transition id="t12"><name><text>12. BTr to DBM: Cash position of the national government</text></name></transition>
      <transition id="t13"><name><text>13. DBM to Servicing banks: Notice of Cash Allocation (NCA). First NCA covers the first quarter. Later NCAs follow the Monthly Disbursement Program, subject to spending performance and the fiscal position</text></name></transition>
      <transition id="t14"><name><text>14. Servicing banks: Credit the limit to the MDS sub-account of the unit: regular, special accounts, trust, or foreign-assisted projects</text></name></transition>
      <transition id="t15"><name><text>15. DBM to ADRS: Advice of NCA Issued</text></name></transition>
      <transition id="t16"><name><text>16. ADRS to Operating units: Agency downloads the advice</text></name></transition>
      <transition id="tau5"><name><text>skip: Cash need above the program</text></name></transition>
      <transition id="t17"><name><text>17. National agency to DBM: Request for additional NCA</text></name></transition>
      <transition id="t18"><name><text>18. DBM to Servicing banks: Additional NCA</text></name></transition>
      <transition id="tau6"><name><text>end of: Cash need above the program</text></name></transition>
      <transition id="t19"><name><text>19. National agency to Operating units: Notice of Transfer of Allocation, where the central office shares its own NCA with a lower unit</text></name></transition>
