digraph seq {
graph [rankdir=TB nodesep=0.25 ranksep=0.3 fontname="Helvetica" label="15f  Cash aid to persons: from the list of beneficiaries to the credit in each account" labelloc=t fontsize=11]
node [fontname="Helvetica" fontsize=8]
edge [arrowsize=0.5]
"p1" [shape=circle width=0.25 fixedsize=true label="start" fontsize=6 style=filled fillcolor="#333333"]
"p2" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p3" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p4" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p5" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p6" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p7" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p8" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p9" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p10" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p11" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p12" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p13" [shape=circle width=0.25 fixedsize=true label="end" fontsize=6 style=filled fillcolor="#ffffff"]
"t01" [shape=box style=rounded label="1. Congress to Program office: Program law:\nwho qualifies, conditions, kinds of grant.\nBudget law: the amount for the year" tooltip="15f-01"]
"t02" [shape=box style=rounded label="2. Program office: Select households with a\nstandardized targeting system. Check the list\nagain every three years" tooltip="15f-02"]
"t03" [shape=box style=rounded label="3. Program office: Amount of each grant, as\nfixed by the advisory council of the program\nand reviewed every six years" tooltip="15f-03"]
"t04" [shape=box style=rounded label="4. Program office: Check that each household\nmet the conditions (for example school\nattendance, health visits)" tooltip="15f-04"]
"t05" [shape=box style=rounded label="5. Program office: Payroll of beneficiaries\nfor the period, certified and approved.\nObligation recorded against the allotment" tooltip="15f-05"]
"t06" [shape=box style=rounded label="6. DBM to Program office: Cash authority (NCA)\nfor the period (chapter 05)" tooltip="15f-06"]
"t07" [shape=box style=rounded label="7. Program office to Payment agents: Payment\norder with the list of accounts, within the\ncash authority" tooltip="15f-07"]
"t08" [shape=box style=rounded label="8. Payment agents to Beneficiaries: Grant\ncredited to the account of the household, or\npaid out by a remittance institution" tooltip="15f-08"]
"t09" [shape=box style=rounded label="9. Payment agents to Program office: Report of\namounts credited and of amounts not credited" tooltip="15f-09"]
"t10" [shape=box style=rounded label="10. Program office: Accounting entries.\nAmounts not credited are returned or paid\nagain" tooltip="15f-10"]
"t11" [shape=box style=rounded label="11. Program office to Congress: Yearly report\non the program, before the President's budget\nmessage" tooltip="15f-11"]
"t12" [shape=box style=rounded label="12. COA to Program office: Independent\nmonitoring committee, and audit by COA" tooltip="15f-12"]
"p1" -> "t01"
"t01" -> "p2"
"p2" -> "t02"
"t02" -> "p3"
"p3" -> "t03"
"t03" -> "p4"
"p4" -> "t04"
"t04" -> "p5"
"p5" -> "t05"
"t05" -> "p6"
"p6" -> "t06"
"t06" -> "p7"
"p7" -> "t07"
"t07" -> "p8"
"p8" -> "t08"
"t08" -> "p9"
"p9" -> "t09"
"t09" -> "p10"
"p10" -> "t10"
"t10" -> "p11"
"p11" -> "t11"
"t11" -> "p12"
"p12" -> "t12"
"t12" -> "p13"
}