"p21" [shape=circle width=0.25 fixedsize=true label="end" fontsize=6 style=filled fillcolor="#ffffff"]
"t01" [shape=box style=rounded label="1. Accounting unit to COA audit team:\nAccounts: paid vouchers with the daily reports\nof payments, journal entries, reports. Year-\nend statements by 14 February" tooltip="09a-01"]
"t02" [shape=box style=rounded label="2. COA audit team: Audit: financial (are the\nstatements fairly presented), compliance (were\nthe rules followed), performance (were results\nachieved with economy)" tooltip="09a-02"]
"t03" [shape=box style=rounded label="3. COA audit team to Head of agency: Audit\nObservation Memorandum on each finding" tooltip="09a-03"]
"t04" [shape=box style=rounded label="4. Head of agency to COA audit team: Comments,\nexplanations, documents" tooltip="09a-04"]
"t05" [shape=box style=rounded label="5. COA audit team to Head of agency: Notice of\nSuspension. The amount is suspended until the\nrequirement is met" tooltip="09a-05"]
"tau1" [shape=box width=0.15 height=0.15 style=filled fillcolor="#444444" label="" tooltip="end of: Finding on a transaction: a requirement is missing"]
"t06" [shape=box style=rounded label="6. COA audit team to Head of agency: Notice of\nDisallowance, naming the persons liable" tooltip="09a-06"]
"tau2" [shape=box width=0.15 height=0.15 style=filled fillcolor="#444444" label="" tooltip="end of: Finding on a transaction: illegal, irregular, unnecessary, excessive or extravagant expense"]
"t07" [shape=box style=rounded label="7. COA audit team to Head of agency: Notice of\nCharge, naming the persons liable" tooltip="09a-07"]
"tau3" [shape=box width=0.15 height=0.15 style=filled fillcolor="#444444" label="" tooltip="end of: Finding on revenue: under-assessment or under-collection"]
"t08" [shape=box style=rounded label="8. Head of agency to COA audit team:\nRequirement met, or amount returned" tooltip="09a-08"]
"t09" [shape=box style=rounded label="9. COA audit team to Head of agency: Notice of\nSettlement" tooltip="09a-09"]
"tau4" [shape=box width=0.15 height=0.15 style=filled fillcolor="#444444" label="" tooltip="end of: Persons liable comply"]
"t10" [shape=box style=rounded label="10. Head of agency to COA directors: Appeal" tooltip="09a-10"]
"t11" [shape=box style=rounded label="11. COA directors to Head of agency: Decision" tooltip="09a-11"]
"t12" [shape=box style=rounded label="12. Head of agency to COA Commission Proper:\nPetition for review" tooltip="09a-12"]
"t13" [shape=box style=rounded label="13. COA Commission Proper to Head of agency:\nDecision of the Commission Proper" tooltip="09a-13"]
"tau5" [shape=box width=0.15 height=0.15 style=filled fillcolor="#444444" label="" tooltip="end of: Persons liable contest"]
"t14" [shape=box style=rounded label="14. COA audit team to Head of agency: When a\ndecision is final: Notice of Finality of\nDecision. The agency records a receivable from\nthe persons liable. Then COA Order of\nExecution (for example, withholding of pay)" tooltip="09a-14"]
"t15" [shape=box style=rounded label="15. COA audit team to Head of agency: Each\nquarter: Statement of Audit Suspensions,\nDisallowances and Charges" tooltip="09a-15"]
"t16" [shape=box style=rounded label="16. COA audit team to Head of agency: Draft\nfindings discussed. Then the audit report of\nthe agency: opinion on the statements,\nobservations and recommendations, status of\nearlier recommendations" tooltip="09a-16"]
"t17" [shape=box style=rounded label="17. Head of agency to COA audit team: Action\nplan on the recommendations" tooltip="09a-17"]
"t18" [shape=box style=rounded label="18. COA audit team to President: COA annual\nreport on the financial condition and\noperation of the government, by 30 September" tooltip="09a-18"]
