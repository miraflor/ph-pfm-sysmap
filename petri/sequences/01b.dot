digraph seq {
graph [rankdir=TB nodesep=0.25 ranksep=0.3 fontname="Helvetica" label="01b  Investment programming: how a project enters the PIP and TRIP and reaches the budget" labelloc=t fontsize=11]
node [fontname="Helvetica" fontsize=8]
edge [arrowsize=0.5]
"p1" [shape=circle width=0.25 fixedsize=true label="start" fontsize=6 style=filled fillcolor="#333333"]
"p2" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p3" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p4" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p5" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p6" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p7" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p8" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p9" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p10" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p11" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p12" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p13" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p14" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p15" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p16" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p17" [shape=circle width=0.25 fixedsize=true label="end" fontsize=6 style=filled fillcolor="#ffffff"]
"t01" [shape=box style=rounded label="1. PIP and TRIP secretariats to National\nagency: Joint call to update the PIP and\nformulate the TRIP, with guidelines and\ncalendar" tooltip="01b-01"]
"t02" [shape=box style=rounded label="2. Operating units to Regional Development\nCouncils: Regional priority programs and\nprojects" tooltip="01b-02"]
"t03" [shape=box style=rounded label="3. Regional Development Councils to Operating\nunits: Endorsement, or recommendations" tooltip="01b-03"]
"t04" [shape=box style=rounded label="4. National agency to PIPOL: Reconfirm ongoing\nprograms and projects. Encode new or updated\nones: cost per year, physical and financial\nprogress" tooltip="01b-04"]
"t05" [shape=box style=rounded label="5. National agency to PIPOL: Head of agency\nendorses the submission (example window: 8\nNovember to 6 December 2024)" tooltip="01b-05"]
"t06" [shape=box style=rounded label="6. PIPOL to PIP and TRIP secretariats: Only\nsubmissions marked \"as endorsed\" are processed" tooltip="01b-06"]
"t07" [shape=box style=rounded label="7. PIP and TRIP secretariats: Check each entry\nagainst the PIP criteria and the scope of the\nTRIP" tooltip="01b-07"]
"tau1" [shape=box width=0.15 height=0.15 style=filled fillcolor="#444444" label="" tooltip="skip: Project needs ICC review"]
"t08" [shape=box style=rounded label="8. National agency to ICC: Project proposal\nwith feasibility study and financing plan" tooltip="01b-08"]
"t09" [shape=box style=rounded label="9. ICC: Technical, economic and financial\nappraisal" tooltip="01b-09"]
"t10" [shape=box style=rounded label="10. ICC to ED Council: Recommendation" tooltip="01b-10"]
"t11" [shape=box style=rounded label="11. ED Council to National agency: Approval or\nconfirmation" tooltip="01b-11"]
"tau2" [shape=box width=0.15 height=0.15 style=filled fillcolor="#444444" label="" tooltip="end of: Project needs ICC review"]
"t12" [shape=box style=rounded label="12. PIP and TRIP secretariats to DBM: PIP and\nTRIP as input to budget preparation" tooltip="01b-12"]
"t13" [shape=box style=rounded label="13. DBM to National agency: Budget Call. A\nTier 2 proposal must be implementation-ready\nand must have the required endorsements and\napprovals" tooltip="01b-13"]
"t14" [shape=box style=rounded label="14. National agency to DBM: Tier 2 proposals\nin OSBPS (a different system from PIPOL)" tooltip="01b-14"]
"t15" [shape=box style=rounded label="15. National agency to PIPOL: After the budget\nis known, update yearly costs to match the GAA\nand the National Expenditure Program" tooltip="01b-15"]
"p1" -> "t01"
"t01" -> "p2"
"p2" -> "t02"
"t02" -> "p3"
"p3" -> "t03"
"t03" -> "p4"
"p4" -> "t04"
"t04" -> "p5"
"p5" -> "t05"
"t05" -> "p6"
"p6" -> "t06"
"t06" -> "p7"
"p7" -> "t07"
"t07" -> "p8"
"p8" -> "tau1"
"tau1" -> "p9"
"p8" -> "t08"
"t08" -> "p10"
"p10" -> "t09"
"t09" -> "p11"
"p11" -> "t10"
"t10" -> "p12"
"p12" -> "t11"
"t11" -> "p13"
"p13" -> "tau2"
"tau2" -> "p9"
"p9" -> "t12"
"t12" -> "p14"
"p14" -> "t13"
"t13" -> "p15"
"p15" -> "t14"
"t14" -> "p16"
"p16" -> "t15"
"t15" -> "p17"
}