digraph seq {
graph [rankdir=TB nodesep=0.25 ranksep=0.3 fontname="Helvetica" label="15b  Transfer of funds from one agency to another body that will implement" labelloc=t fontsize=11]
node [fontname="Helvetica" fontsize=8]
edge [arrowsize=0.5]
"p1" [shape=circle width=0.25 fixedsize=true label="start" fontsize=6 style=filled fillcolor="#333333"]
"p2" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p3" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p4" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p5" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p6" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p7" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p8" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p9" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p10" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p11" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p12" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p13" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p14" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p15" [shape=circle width=0.25 fixedsize=true label="end" fontsize=6 style=filled fillcolor="#ffffff"]
"t01" [shape=box style=rounded label="1. National agency to Implementing body:\nMemorandum of agreement: purpose, amount\n(enough for three months, or the total project\ncost), period, reports" tooltip="15b-01"]
"t02" [shape=box style=rounded label="2. National agency: Obligation recorded\nagainst its own allotment" tooltip="15b-02"]
"t03" [shape=box style=rounded label="3. National agency to Implementing body: Check\nin the name of the implementing body. The\nreceiver issues an official receipt" tooltip="15b-03"]
"t04" [shape=box style=rounded label="4. National agency: Books: Due from National\nGovernment Agencies (a receivable). Not yet an\nexpense, not yet a disbursement in the budget\nreports" tooltip="15b-04"]
"t05" [shape=box style=rounded label="5. Implementing body: Trust fund books: Due to\nNGAs (a liability). The money goes to a trust\naccount, or to the Treasury, from which DBM\ngives an NCA for trust" tooltip="15b-05"]
"t06" [shape=box style=rounded label="6. Implementing body to Suppliers and payees:\nProcurement, contract" tooltip="15b-06"]
"t07" [shape=box style=rounded label="7. Suppliers and payees to Implementing body:\nDelivery, inspected and accepted" tooltip="15b-07"]
"t08" [shape=box style=rounded label="8. Implementing body to Suppliers and payees:\nPayment from the trust account or under the\nNCA for trust" tooltip="15b-08"]
"t09" [shape=box style=rounded label="9. Implementing body to National agency:\nWithin ten days after each month: reports of\nchecks issued and of cash disbursements,\napproved by the head of the implementing body" tooltip="15b-09"]
"t10" [shape=box style=rounded label="10. National agency: Books: expense recorded,\nreceivable reduced. Now reported as disbursed.\nThe implementing body reduces its liability by\nthe same expenses" tooltip="15b-10"]
"tau1" [shape=box width=0.15 height=0.15 style=filled fillcolor="#444444" label="" tooltip="skip: Money remains at the end of the project or of the validity period"]
"t11" [shape=box style=rounded label="11. Implementing body to National agency:\nUnused balance returned, if the agreement says\nso" tooltip="15b-11"]
"tau2" [shape=box width=0.15 height=0.15 style=filled fillcolor="#444444" label="" tooltip="end of: Money remains at the end of the project or of the validity period"]
"t12" [shape=box style=rounded label="12. National agency to DBM: FAR 1-C each\nquarter: obligations, disbursements,\nliquidations and balances of fund transfers" tooltip="15b-12"]
"t13" [shape=box style=rounded label="13. COA to National agency: The auditor of the\nimplementing body audits its payments. The\nauditor of the source agency audits the\ntransfer" tooltip="15b-13"]
"p1" -> "t01"
"t01" -> "p2"
"p2" -> "t02"
"t02" -> "p3"
"p3" -> "t03"
"t03" -> "p4"
"p4" -> "t04"
"t04" -> "p5"
"p5" -> "t05"
"t05" -> "p6"
"p6" -> "t06"
"t06" -> "p7"
"p7" -> "t07"
"t07" -> "p8"
"p8" -> "t08"
"t08" -> "p9"
"p9" -> "t09"
"t09" -> "p10"
"p10" -> "t10"
"t10" -> "p11"
"p11" -> "tau1"
"tau1" -> "p12"
"p11" -> "t11"
"t11" -> "p13"
"p13" -> "tau2"
"tau2" -> "p12"
"p12" -> "t12"
"t12" -> "p14"
"p14" -> "t13"
"t13" -> "p15"
}