<?xml version="1.0" encoding="UTF-8"?>
<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml">
  <net id="SEQ-14f" type="http://www.pnml.org/version-2009/grammar/ptnet">
    <name><text>14f The budget of a barangay: who prepares, who enacts, who reviews</text></name>
    <page id="page1">
      <place id="p1"><name><text>start</text></name><initialMarking><text>1</text></initialMarking></place>
      <place id="p2"><name><text>p2</text></name></place>
      <place id="p3"><name><text>p3</text></name></place>
      <place id="p4"><name><text>p4</text></name></place>
      <place id="p5"><name><text>p5</text></name></place>
      <place id="p6"><name><text>p6</text></name></place>
      <place id="p7"><name><text>p7</text></name></place>
      <place id="p8"><name><text>p8</text></name></place>
      <place id="p9"><name><text>p9</text></name></place>
      <place id="p10"><name><text>p10</text></name></place>
      <place id="p11"><name><text>p11</text></name></place>
      <place id="p12"><name><text>p12</text></name></place>
      <place id="p13"><name><text>end</text></name></place>
      <transition id="t01"><name><text>1. Barangay to Barangay: Estimate of income for the next year, and statements of income and expenditure, on or before 15 September</text></name></transition>
      <transition id="t02"><name><text>2. Barangay: Prepare the budget with the treasurer. Mandatory items: 10 percent of the general fund for the youth council, at least 20 percent of the tax allotment for development, 5 percent of regular income for calamities. Personal services at most 55 percent of last year's income</text></name></transition>
      <transition id="t03"><name><text>3. Barangay to Barangay: Budget, on or before 16 October</text></name></transition>
      <transition id="t04"><name><text>4. Barangay: Appropriation ordinance, by a majority of all members. The punong barangay votes only when the votes are equal and has no veto</text></name></transition>
      <transition id="t05"><name><text>5. Barangay to Local treasurer: Ordinance, within 10 days after enactment</text></name></transition>
      <transition id="t06"><name><text>6. Local treasurer to Sanggunian: Ordinance with findings</text></name></transition>
      <transition id="t07"><name><text>7. Sanggunian: Review within 60 days: legal requirements and limits are met, appropriations do not exceed estimated income</text></name></transition>
      <transition id="t08"><name><text>8. Sanggunian to Barangay: The ordinance is deemed to be in full force</text></name></transition>
      <transition id="tau1"><name><text>end of: No action within 60 days</text></name></transition>
      <transition id="t09"><name><text>9. Sanggunian to Barangay: Returned for adjustment. The treasurer may make no further payments from the inoperative part</text></name></transition>
      <transition id="tau2"><name><text>end of: Found inoperative, in whole or in part</text></name></transition>
      <transition id="t10"><name><text>10. Barangay: Custody of the funds. Collections and payments</text></name></transition>
      <transition id="t11"><name><text>11. Barangay to Local treasurer: Records of transactions. The accounts are kept in the offices of the barangay treasurer and of the city or municipal accountant</text></name></transition>
      <arc id="a1" source="p1" target="t01"/>
