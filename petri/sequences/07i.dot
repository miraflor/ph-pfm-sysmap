"p14" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p15" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p16" [shape=circle width=0.25 fixedsize=true label="end" fontsize=6 style=filled fillcolor="#ffffff"]
"t01" [shape=box style=rounded label="1. Suppliers and payees to Cash unit:\nPerformance security before the contract is\nsigned. In the example: cash of 75,000. Books:\nGuaranty/Security Deposits Payable 75,000" tooltip="07i-01"]
"t02" [shape=box style=rounded label="2. Budget unit: Obligation for the whole\ncontract price: 800,000 in the registry. No\njournal entry" tooltip="07i-02"]
"t03" [shape=box style=rounded label="3. Suppliers and payees to Project unit:\nWritten request for an advance, with a letter\nof credit, a bank guarantee or a surety bond" tooltip="07i-03"]
"t04" [shape=box style=rounded label="4. Accounting unit to Suppliers and payees:\nAdvance of 15 percent: 120,000. Books: debit\nAdvances to Contractors 120,000, credit Cash-\nMDS, Regular 120,000" tooltip="07i-04"]
"t05" [shape=box style=rounded label="5. Suppliers and payees to Project unit:\nStatement of work accomplished: 400,000" tooltip="07i-05"]
"t06" [shape=box style=rounded label="6. Project unit to Accounting unit: The\nengineer checks the statement and certifies\nthe amount to be paid" tooltip="07i-06"]
"t07" [shape=box style=rounded label="7. Accounting unit: Books: debit Construction\nin Progress 400,000. Credit Advances to\nContractors 60,000 (half of the advance is\nrecovered) and Accounts Payable 340,000" tooltip="07i-07"]
"t08" [shape=box style=rounded label="8. Accounting unit to Suppliers and payees:\nPayment of 282,200. Books: debit Accounts\nPayable 340,000. Credit Cash-MDS, Regular\n282,200, Guaranty/Security Deposits Payable\n34,000 (retention), Due to BIR 23,800 (tax\nwithheld)" tooltip="07i-08"]
"t09" [shape=box style=rounded label="9. Suppliers and payees to Project unit:\nStatement of work accomplished: 400,000.\nCertificate of completion" tooltip="07i-09"]
"t10" [shape=box style=rounded label="10. Accounting unit: Books: debit Construction\nin Progress 400,000. Credit Advances to\nContractors 60,000 and Accounts Payable\n340,000" tooltip="07i-10"]
"t11" [shape=box style=rounded label="11. Suppliers and payees to Cash unit: Damages\nfor the delay: 8,000, collected in cash.\nBooks: Miscellaneous Income 8,000" tooltip="07i-11"]
"t12" [shape=box style=rounded label="12. Accounting unit to Suppliers and payees:\nPayment of 282,200. Retention 34,000. Tax\nwithheld 23,800" tooltip="07i-12"]
"t13" [shape=box style=rounded label="13. Accounting unit: Turn-over of the\nbuilding. Books: debit Buildings 800,000,\ncredit Construction in Progress 800,000" tooltip="07i-13"]
"t14" [shape=box style=rounded label="14. Accounting unit to Suppliers and payees:\nRelease of the retention money: 68,000. Books:\ndebit Guaranty/Security Deposits Payable\n68,000, credit Cash-MDS, Regular 68,000" tooltip="07i-14"]
"t15" [shape=box style=rounded label="15. Cash unit to Suppliers and payees: Return\nof the performance security: 75,000" tooltip="07i-15"]
"p1" -> "t01"
"t01" -> "p2"
"p2" -> "t02"
"t02" -> "p3"
