digraph seq {
graph [rankdir=TB nodesep=0.25 ranksep=0.3 fontname="Helvetica" label="07i  A works contract with an advance, progress billings and retention money (example of the Manual)" labelloc=t fontsize=11]
node [fontname="Helvetica" fontsize=8]
edge [arrowsize=0.5]
"p1" [shape=circle width=0.25 fixedsize=true label="start" fontsize=6 style=filled fillcolor="#333333"]
"p2" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p3" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
