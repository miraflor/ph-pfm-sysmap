<?xml version="1.0" encoding="UTF-8"?>
<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml">
  <net id="SEQ-16f" type="http://www.pnml.org/version-2009/grammar/ptnet">
    <name><text>16f Public verification of DBM release documents with a blockchain record</text></name>
    <page id="page1">
      <place id="p1"><name><text>start</text></name><initialMarking><text>1</text></initialMarking></place>
      <place id="p2"><name><text>p2</text></name></place>
      <place id="p3"><name><text>p3</text></name></place>
      <place id="p4"><name><text>p4</text></name></place>
      <place id="p5"><name><text>p5</text></name></place>
      <place id="p6"><name><text>p6</text></name></place>
      <place id="p7"><name><text>p7</text></name></place>
      <place id="p8"><name><text>p8</text></name></place>
      <place id="p9"><name><text>p9</text></name></place>
      <place id="p10"><name><text>end</text></name></place>
      <transition id="t01"><name><text>1. DBM to ADRS: Approved release document (SARO, or advice of NCA)</text></name></transition>
      <transition id="t02"><name><text>2. ADRS to Document verification (blockchain): Record of the issued document</text></name></transition>
      <transition id="t03"><name><text>3. Document verification (blockchain): Store a fingerprint of the document (a hash) with date and document number. The record cannot be changed later</text></name></transition>
      <transition id="t04"><name><text>4. ADRS to National agency: Document for download, with a QR code</text></name></transition>
      <transition id="t05"><name><text>5. National agency to Any person: Copy of the document (for example to a contractor or a bank)</text></name></transition>
      <transition id="t06"><name><text>6. Any person to Document verification (blockchain): Scan the QR code, or enter the document reference</text></name></transition>
      <transition id="t07"><name><text>7. Document verification (blockchain) to Document verification (blockchain): Retrieve the record</text></name></transition>
      <transition id="t08"><name><text>8. Document verification (blockchain) to Document verification (blockchain): Stored record</text></name></transition>
      <transition id="t09"><name><text>9. Document verification (blockchain) to Any person: Result: the copy matches the issued document, or it does not</text></name></transition>
      <arc id="a1" source="p1" target="t01"/>
      <arc id="a2" source="t01" target="p2"/>
      <arc id="a3" source="p2" target="t02"/>
      <arc id="a4" source="t02" target="p3"/>
      <arc id="a5" source="p3" target="t03"/>
      <arc id="a6" source="t03" target="p4"/>
      <arc id="a7" source="p4" target="t04"/>
      <arc id="a8" source="t04" target="p5"/>
      <arc id="a9" source="p5" target="t05"/>
      <arc id="a10" source="t05" target="p6"/>
      <arc id="a11" source="p6" target="t06"/>
      <arc id="a12" source="t06" target="p7"/>
      <arc id="a13" source="p7" target="t07"/>
      <arc id="a14" source="t07" target="p8"/>
      <arc id="a15" source="p8" target="t08"/>
      <arc id="a16" source="t08" target="p9"/>
      <arc id="a17" source="p9" target="t09"/>
      <arc id="a18" source="t09" target="p10"/>
    </page>
  </net>
</pnml>
