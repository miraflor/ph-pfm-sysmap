"tau2" -> "p14"
"p15" -> "tau3"
"tau3" -> "p13"
"p13" -> "t13"
"t13" -> "p16"
"p16" -> "t14"
"t14" -> "p17"
"p17" -> "t15"
"t15" -> "p18"
"p18" -> "t16"
"t16" -> "p19"
"p19" -> "t17"
"t17" -> "p20"
"p20" -> "t18"
"t18" -> "p21"
"p21" -> "t19"
"t19" -> "p22"
"p22" -> "t20"
"t20" -> "p23"
"p23" -> "tau4"
"tau4" -> "p24"
"p23" -> "t21"
"t21" -> "p25"
"p25" -> "t22"
"t22" -> "p26"
"p26" -> "tau5"
"tau5" -> "p24"
}