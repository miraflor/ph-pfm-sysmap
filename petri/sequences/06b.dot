"p16" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p17" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p18" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p19" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p20" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p21" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p22" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p23" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p24" [shape=circle width=0.25 fixedsize=true label="end" fontsize=6 style=filled fillcolor="#ffffff"]
"p25" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p26" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"t01" [shape=box style=rounded label="1. Requesting office to BAC and procurement\nunit: Purchase request, specifications,\nbidding documents for an item in the Annual\nProcurement Plan" tooltip="06b-01"]
"t02" [shape=box style=rounded label="2. BAC and procurement unit to Budget unit:\nAre appropriations available for this\nprocurement?" tooltip="06b-02"]
"t03" [shape=box style=rounded label="3. Budget unit to BAC and procurement unit:\nConfirmation: the item is in the budget law,\nor in the proposed budget for early\nprocurement" tooltip="06b-03"]
"t04" [shape=box style=rounded label="4. BAC and procurement unit: Pre-procurement\nconference: the procurement follows the plan,\nappropriations are available, the award\ncriterion is chosen" tooltip="06b-04"]
"t05" [shape=box style=rounded label="5. BAC and procurement unit to PhilGEPS\n(modernized): Post the invitation to bid and\nthe bidding documents, with the budget for the\ncontract and the source of funding. Also on\nthe website of the entity, and 7 days at its\npremises" tooltip="06b-05"]
"t06" [shape=box style=rounded label="6. PhilGEPS (modernized) to Suppliers and\npayees: Notice visible to registered suppliers" tooltip="06b-06"]
"t07" [shape=box style=rounded label="7. BAC and procurement unit to Suppliers and\npayees: Pre-bid conference, at least 12 days\nbefore the deadline for bids (required from a\nbudget of PHP 3 million)" tooltip="06b-07"]
"t08" [shape=box style=rounded label="8. Suppliers and payees to BAC and procurement\nunit: Bids in two sealed envelopes: technical\n(with eligibility documents and bid security)\nand financial. Deadline: at most 45 days\n(goods), 50 or 65 (works), 75 (consulting)\nafter posting" tooltip="06b-08"]
"t09" [shape=box style=rounded label="9. BAC and procurement unit to Observers:\nInvitation to observe each stage: at least two\nobservers, in addition to the representative\nof COA" tooltip="06b-09"]
"t10" [shape=box style=rounded label="10. BAC and procurement unit: Opening of bids\nimmediately after the deadline. Each envelope\npasses or fails. A bid above the approved\nbudget for the contract is rejected" tooltip="06b-10"]
"t11" [shape=box style=rounded label="11. BAC and procurement unit: Bid evaluation:\n7 days for the lowest calculated bid, 14 days\nwhen quality is rated with price, 21 days for\nconsulting. Rank by the award criterion" tooltip="06b-11"]
"tau1" [shape=box width=0.15 height=0.15 style=filled fillcolor="#444444" label="" tooltip="enter: Until one bidder passes, starting from the first in rank"]
"t12" [shape=box style=rounded label="12. BAC and procurement unit to Suppliers and\npayees: Post-qualification within 12 days:\nverify the legal, technical and financial\ndocuments, with the latest tax returns" tooltip="06b-12"]
"tau2" [shape=box width=0.15 height=0.15 style=filled fillcolor="#444444" label="" tooltip="repeat"]
"tau3" [shape=box width=0.15 height=0.15 style=filled fillcolor="#444444" label="" tooltip="exit the loop"]
"t13" [shape=box style=rounded label="13. BAC and procurement unit to Head of\nagency: Recommendation of award, with the\ndocument that authorizes the entity to incur\nthe obligation" tooltip="06b-13"]
"t14" [shape=box style=rounded label="14. Head of agency to Suppliers and payees:\nApproval within 10 days, then the notice of\naward immediately" tooltip="06b-14"]
"t15" [shape=box style=rounded label="15. Head of agency to PhilGEPS (modernized):\nAward published" tooltip="06b-15"]
"t16" [shape=box style=rounded label="16. Suppliers and payees to Head of agency:\nPerformance security, before signing: 5\npercent (goods, consulting) or 10 percent\n(works) of the contract price, 30 percent as a\nsurety bond" tooltip="06b-16"]
"t17" [shape=box style=rounded label="17. Head of agency to Suppliers and payees:\nContract signed within 10 days from receipt of\nthe notice of award" tooltip="06b-17"]
"t18" [shape=box style=rounded label="18. Head of agency to Suppliers and payees:\nNotice to proceed within 3 days from approval\nof the contract" tooltip="06b-18"]
"t19" [shape=box style=rounded label="19. Observers to Head of agency: Observation\nreport (also to PhilGEPS, and copies to the\nGPPB and the Ombudsman)" tooltip="06b-19"]
"t20" [shape=box style=rounded label="20. Observers to COA: Observation report" tooltip="06b-20"]
"tau4" [shape=box width=0.15 height=0.15 style=filled fillcolor="#444444" label="" tooltip="skip: A losing bidder objects"]
"t21" [shape=box style=rounded label="21. Suppliers and payees to BAC and\nprocurement unit: Request for reconsideration\nwithin 3 days. The BAC decides within 7 days" tooltip="06b-21"]
"t22" [shape=box style=rounded label="22. Suppliers and payees to Head of agency:\nProtest within 7 days, filed electronically,\nwith a fee that is not returned. Decision\nwithin 7 days. It is final for smaller\ncontracts. For the others: review by the\nRegional Trial Court" tooltip="06b-22"]
"tau5" [shape=box width=0.15 height=0.15 style=filled fillcolor="#444444" label="" tooltip="end of: A losing bidder objects"]
"p1" -> "t01"
"t01" -> "p2"
"p2" -> "t02"
"t02" -> "p3"
"p3" -> "t03"
"t03" -> "p4"
