<?xml version="1.0" encoding="UTF-8"?>
<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml">
  <net id="SEQ-15f" type="http://www.pnml.org/version-2009/grammar/ptnet">
    <name><text>15f Cash aid to persons: from the list of beneficiaries to the credit in each account</text></name>
    <page id="page1">
      <place id="p1"><name><text>start</text></name><initialMarking><text>1</text></initialMarking></place>
      <place id="p2"><name><text>p2</text></name></place>
      <place id="p3"><name><text>p3</text></name></place>
      <place id="p4"><name><text>p4</text></name></place>
      <place id="p5"><name><text>p5</text></name></place>
      <place id="p6"><name><text>p6</text></name></place>
      <place id="p7"><name><text>p7</text></name></place>
      <place id="p8"><name><text>p8</text></name></place>
      <place id="p9"><name><text>p9</text></name></place>
      <place id="p10"><name><text>p10</text></name></place>
      <place id="p11"><name><text>p11</text></name></place>
      <place id="p12"><name><text>p12</text></name></place>
      <place id="p13"><name><text>end</text></name></place>
      <transition id="t01"><name><text>1. Congress to Program office: Program law: who qualifies, conditions, kinds of grant. Budget law: the amount for the year</text></name></transition>
      <transition id="t02"><name><text>2. Program office: Select households with a standardized targeting system. Check the list again every three years</text></name></transition>
      <transition id="t03"><name><text>3. Program office: Amount of each grant, as fixed by the advisory council of the program and reviewed every six years</text></name></transition>
      <transition id="t04"><name><text>4. Program office: Check that each household met the conditions (for example school attendance, health visits)</text></name></transition>
      <transition id="t05"><name><text>5. Program office: Payroll of beneficiaries for the period, certified and approved. Obligation recorded against the allotment</text></name></transition>
      <transition id="t06"><name><text>6. DBM to Program office: Cash authority (NCA) for the period (chapter 05)</text></name></transition>
      <transition id="t07"><name><text>7. Program office to Payment agents: Payment order with the list of accounts, within the cash authority</text></name></transition>
      <transition id="t08"><name><text>8. Payment agents to Beneficiaries: Grant credited to the account of the household, or paid out by a remittance institution</text></name></transition>
      <transition id="t09"><name><text>9. Payment agents to Program office: Report of amounts credited and of amounts not credited</text></name></transition>
      <transition id="t10"><name><text>10. Program office: Accounting entries. Amounts not credited are returned or paid again</text></name></transition>
      <transition id="t11"><name><text>11. Program office to Congress: Yearly report on the program, before the President's budget message</text></name></transition>
      <transition id="t12"><name><text>12. COA to Program office: Independent monitoring committee, and audit by COA</text></name></transition>
      <arc id="a1" source="p1" target="t01"/>
      <arc id="a2" source="t01" target="p2"/>
      <arc id="a3" source="p2" target="t02"/>
      <arc id="a4" source="t02" target="p3"/>
      <arc id="a5" source="p3" target="t03"/>
      <arc id="a6" source="t03" target="p4"/>
