"t01" [shape=box style=rounded label="1. President to House plenary: President's\nbudget: NEP, BESF, Budget Message, within 30\ndays from the opening of the regular session" tooltip="04a-01"]
"t02" [shape=box style=rounded label="2. House plenary to House Appropriations: The\nNEP is filed as the General Appropriations\nBill (GAB) and referred to the committee" tooltip="04a-02"]
"t03" [shape=box style=rounded label="3. DBCC to House Appropriations: Briefing on\nthe economy and the fiscal program" tooltip="04a-03"]
"tau1" [shape=box width=0.15 height=0.15 style=filled fillcolor="#444444" label="" tooltip="parallel split"]
"tau2" [shape=box width=0.15 height=0.15 style=filled fillcolor="#444444" label="" tooltip="parallel join"]
"t04" [shape=box style=rounded label="4. House Appropriations to National agency:\nHearings, agency by agency: plans, past\nperformance" tooltip="04a-04"]
"t05" [shape=box style=rounded label="5. National agency to House Appropriations:\nAnswers and documents" tooltip="04a-05"]
"t06" [shape=box style=rounded label="6. Senate Finance to National agency:\nHearings, agency by agency" tooltip="04a-06"]
"t07" [shape=box style=rounded label="7. National agency to Senate Finance: Answers\nand documents" tooltip="04a-07"]
"t08" [shape=box style=rounded label="8. House Appropriations to House plenary:\nCommittee report on the GAB" tooltip="04a-08"]
"t09" [shape=box style=rounded label="9. House plenary: Plenary debates and\namendments. Approval on second and third\nreading" tooltip="04a-09"]
"t10" [shape=box style=rounded label="10. House plenary to Senate plenary: GAB as\napproved by the House" tooltip="04a-10"]
"t11" [shape=box style=rounded label="11. Senate Finance to Senate plenary:\nCommittee report with Senate amendments" tooltip="04a-11"]
"t12" [shape=box style=rounded label="12. Senate plenary: Plenary debates and\namendments. Approval on second and third\nreading" tooltip="04a-12"]
"t13" [shape=box style=rounded label="13. House plenary to Bicameral committee:\nHouse conferees and House version" tooltip="04a-13"]
"t14" [shape=box style=rounded label="14. Senate plenary to Bicameral committee:\nSenate conferees and Senate version" tooltip="04a-14"]
"t15" [shape=box style=rounded label="15. Bicameral committee: Reconcile the two\nversions" tooltip="04a-15"]
"t16" [shape=box style=rounded label="16. Bicameral committee to House plenary:\nConference report" tooltip="04a-16"]
"t17" [shape=box style=rounded label="17. Bicameral committee to Senate plenary:\nConference report" tooltip="04a-17"]
"t18" [shape=box style=rounded label="18. House plenary to President: Both chambers\nratify. The enrolled bill goes to the\nPresident" tooltip="04a-18"]
"t19" [shape=box style=rounded label="19. President: Review. May veto particular\nitems. The items not vetoed become law" tooltip="04a-19"]
"t20" [shape=box style=rounded label="20. President to DBM: Signed General\nAppropriations Act (GAA)" tooltip="04a-20"]
"tau3" [shape=box width=0.15 height=0.15 style=filled fillcolor="#444444" label="" tooltip="skip: Congress disagrees with a veto"]
"t21" [shape=box style=rounded label="21. House plenary to President: Override by\ntwo thirds of each chamber" tooltip="04a-21"]
"tau4" [shape=box width=0.15 height=0.15 style=filled fillcolor="#444444" label="" tooltip="end of: Congress disagrees with a veto"]
