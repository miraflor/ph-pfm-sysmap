"p9" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p10" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p11" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p12" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p13" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p14" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p15" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p16" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p17" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p18" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p19" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p20" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p21" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p22" [shape=circle width=0.25 fixedsize=true label="" fontsize=6 style=filled fillcolor="#ffffff"]
"p23" [shape=circle width=0.25 fixedsize=true label="end" fontsize=6 style=filled fillcolor="#ffffff"]
"t01" [shape=box style=rounded label="1. National agency to ICC: Project proposal\nfor ICC review" tooltip="11d-01"]
"t02" [shape=box style=rounded label="2. ICC to National agency: ICC recommendation,\nED Council approval" tooltip="11d-02"]
"t03" [shape=box style=rounded label="3. National agency to DBM: Request to provide\nfor the project in the budget" tooltip="11d-03"]
"t04" [shape=box style=rounded label="4. DBM to DOF: Forward Obligational Authority\n(project loan)" tooltip="11d-04"]
"t05" [shape=box style=rounded label="5. DOF to Monetary Board: Request for approval\nin principle of the loan terms" tooltip="11d-05"]
"t06" [shape=box style=rounded label="6. Monetary Board to DOF: Approval in\nprinciple" tooltip="11d-06"]
"t07" [shape=box style=rounded label="7. DOF to Office of the President: Request for\nSpecial Authority, at least 10 working days\nbefore the date needed, with: agency letter,\ndraft loan agreement, Monetary Board\nconcurrence, statement of compliance with\nlaws, Forward Obligational Authority" tooltip="11d-07"]
"t08" [shape=box style=rounded label="8. Office of the President to DOF: Special\nAuthority (or Full Powers) to negotiate and\nsign" tooltip="11d-08"]
"t09" [shape=box style=rounded label="9. DOF to Dealers and lenders: Negotiation.\nLoan documents cleared by the inter-agency\ncommittee that reviews foreign loan documents" tooltip="11d-09"]
"t10" [shape=box style=rounded label="10. DOF to Dealers and lenders: Loan agreement\nsigned" tooltip="11d-10"]
"t11" [shape=box style=rounded label="11. Monetary Board to DOF: Final approval of\nthe loan terms" tooltip="11d-11"]
"t12" [shape=box style=rounded label="12. DOJ to DOF: Legal opinion on the authority\nof the borrower" tooltip="11d-12"]
"t13" [shape=box style=rounded label="13. Dealers and lenders to DOF: Loan declared\neffective" tooltip="11d-13"]
"t14" [shape=box style=rounded label="14. National agency to Dealers and lenders:\nWithdrawal application, after the delivery is\naccepted and the bill is approved. The agency\nrecords the asset and a payable" tooltip="11d-14"]
"t15" [shape=box style=rounded label="15. Dealers and lenders: Pays the supplier\ndirectly" tooltip="11d-15"]
"t16" [shape=box style=rounded label="16. BTr to National agency: Journal entry\nvoucher of BTr: the lender has paid. BTr\nrecords the subsidy to the agency and the loan" tooltip="11d-16"]
"t17" [shape=box style=rounded label="17. National agency to DBM: Copy of that\nvoucher and the list of suppliers paid" tooltip="11d-17"]
"t18" [shape=box style=rounded label="18. DBM to National agency: Non-Cash Availment\nAuthority. The agency closes the payable\nagainst Subsidy from National Government" tooltip="11d-18"]
"tau1" [shape=box width=0.15 height=0.15 style=filled fillcolor="#444444" label="" tooltip="end of: Direct payment"]
"t19" [shape=box style=rounded label="19. Dealers and lenders to BTr: Loan proceeds\nto the Treasury. BTr records cash and Loans\nPayable-Foreign on the credit advice of BSP" tooltip="11d-19"]
"t20" [shape=box style=rounded label="20. DBM to National agency: NCA under the MDS\nsub-account for foreign-assisted projects" tooltip="11d-20"]
"tau2" [shape=box width=0.15 height=0.15 style=filled fillcolor="#444444" label="" tooltip="end of: Cash through the Treasury"]
"t21" [shape=box style=rounded label="21. BTr to Dealers and lenders: Interest and\nprincipal on the due dates, from the Treasury\nSingle Account. Only the books of BTr record\nthem: principal reduces the loan payable,\ninterest is an expense" tooltip="11d-21"]
"p1" -> "t01"
"t01" -> "p2"
"p2" -> "t02"
"t02" -> "p3"
"p3" -> "t03"
"t03" -> "p4"
"p4" -> "t04"
"t04" -> "p5"
"p5" -> "t05"
"t05" -> "p6"
