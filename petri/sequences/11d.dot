"p12" -> "t12"
"t12" -> "p13"
"p13" -> "t13"
"t13" -> "p14"
"p14" -> "t14"
"t14" -> "p16"
"p16" -> "t15"
"t15" -> "p17"
"p17" -> "t16"
"t16" -> "p18"
"p18" -> "t17"
"t17" -> "p19"
"p19" -> "t18"
"t18" -> "p20"
"p20" -> "tau1"
"tau1" -> "p15"
"p14" -> "t19"
"t19" -> "p21"
"p21" -> "t20"
"t20" -> "p22"
"p22" -> "tau2"
"tau2" -> "p15"
"p15" -> "t21"
"t21" -> "p23"
}